---
import '../styles/global.css';
import { tokens } from '@aglaya/design-tokens';
import ClientRouter from 'astro/components/ClientRouter.astro';
import CookieBanner from '../components/CookieBanner.astro';
import CustomCursor from '../components/CustomCursor.astro';
import SentryBrowser from '../components/SentryBrowser.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  lang?: string;
  alternateUrl?: string;
  alternateUrlEs?: string;
  alternateUrlPt?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'AGLAYA builds AI-powered automation infrastructure for digital businesses. We install systems, not campaigns. You own everything.',
  ogImage = '/images/og-default.png',
  ogType = 'website',
  lang = 'en',
  alternateUrl,
  alternateUrlEs,
  alternateUrlPt,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageAbsolute = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, Astro.site).href;

// Derive EN path to compute alternate URLs
const enUrl = lang === 'en'
  ? canonicalURL.href
  : (alternateUrl ?? new URL('/', Astro.site).href);
const enPath = new URL(enUrl).pathname;

const esUrl = lang === 'es'
  ? canonicalURL.href
  : (alternateUrlEs ?? new URL(enPath === '/' ? '/es/' : `/es${enPath}`, Astro.site).href);

const ptUrl = lang === 'pt'
  ? canonicalURL.href
  : (alternateUrlPt ?? new URL(enPath === '/' ? '/pt/' : `/pt${enPath}`, Astro.site).href);

const ogLocale = lang === 'pt' ? 'pt_BR' : lang === 'es' ? 'es_ES' : 'en_US';
const fullTitle = title;
const sentryDsn = import.meta.env.PUBLIC_SENTRY_DSN || '';
const sentryEnvironment =
  process.env.CONTEXT ||
  process.env.SENTRY_ENVIRONMENT ||
  process.env.NODE_ENV ||
  'production';
const sentryRelease =
  import.meta.env.PUBLIC_SENTRY_RELEASE ||
  process.env.COMMIT_REF ||
  process.env.DEPLOY_ID ||
  '';

// Organization LD+JSON structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "AGLAYA",
  "alternateName": "The Uncomfortable Agency",
  "url": "https://aglaya.biz",
  "logo": "https://aglaya.biz/android-chrome-512x512.png",
  "description": "Digital marketing and brand strategy AI·gency focused on conversion.",
  "sameAs": [],
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "info@aglaya.biz",
    "contactType": "customer service"
  }
};

// WebSite schema with potential SearchAction (enables sitelinks search box in Google)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "AGLAYA",
  "url": "https://aglaya.biz",
  "inLanguage": ["en", "es", "pt-BR"],
  "description": "AI-powered automation agency building operational systems for digital businesses."
};

---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <!-- Google Tag Manager — loads only when user has consented to 'all' cookies -->
    <script>
      window.dataLayer = window.dataLayer || [];
      if (!window.__aglayaAnalyticsBound) {
        window.__aglayaAnalyticsBound = true;
        window.addEventListener('aglaya:track', function(e) {
          var detail = e && e.detail ? e.detail : {};
          if (!detail.event) return;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(Object.assign({
            event: detail.event,
            page_path: window.location.pathname,
            page_title: document.title,
            page_language: document.documentElement.lang || 'en'
          }, detail.payload || {}));
        });
      }
      function _loadGTM() {
        if (window.__gtmLoaded) return;
        window.__gtmLoaded = true;
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-5BVC9C5C');
      }
      if (localStorage.getItem('aglaya_cookie_consent') === 'all') {
        _loadGTM();
      } else {
        window.addEventListener('aglaya:consent-update', function(e) {
          if (e.detail && e.detail.consent === 'all') _loadGTM();
        }, { once: true });
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <!-- A meta attribute cannot hold a CSS variable, so the value is injected
         at build time from the package. Same source, different mechanism. -->
    <meta name="theme-color" content={tokens['--color-brand']} />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang — trilingual SEO, no duplicate content -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="pt-BR" href={ptUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AGLAYA — The Uncomfortable Agency" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="AGLAYA" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <meta name="twitter:image:alt" content="AGLAYA — The Uncomfortable Agency" />

    <!-- Favicon suite -->
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-aglaya.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts: Outfit + Inter + Space Mono are served from this origin, declared
         by @aglaya/design-tokens and emitted into /_astro/ by the build. No
         Google Fonts link, no preconnect: the families now ride the same
         versioned contract as the colours, and no visitor IP leaves for a third
         party before the consent banner has said anything. -->

    <!-- LD+JSON — Organization + WebSite structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    {sentryDsn && (
      <SentryBrowser dsn={sentryDsn} environment={sentryEnvironment} release={sentryRelease} />
    )}

    <!-- Client-side navigation (View Transitions API) -->
    <ClientRouter />
  </head>
  <body class="bg-black text-white selection:bg-brand/30 selection:text-white overflow-x-hidden">
    <a href="#main-content" class="skip-link">
      {lang === 'es' ? 'Saltar al contenido principal' : lang === 'pt' ? 'Pular para o conteúdo principal' : 'Skip to main content'}
    </a>
    <slot />
    <CookieBanner lang={lang as 'en' | 'es' | 'pt'} />
    <CustomCursor />

    <script>
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      // Reactive background logic
      function initGlow() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (window.matchMedia('(hover: none)').matches) return;
        
        const updateMousePosition = (e) => {
          document.documentElement.style.setProperty('--mouse-x', `${e.clientX}px`);
          document.documentElement.style.setProperty('--mouse-y', `${e.clientY}px`);
          
          if (!document.body.classList.contains('glow-active')) {
             document.body.classList.add('glow-active');
          }
        };
        
        window.addEventListener('mousemove', updateMousePosition, { passive: true });
        
        // Cleanup so it doesn't duplicate on page transitions
        document.addEventListener('astro:before-swap', () => {
          window.removeEventListener('mousemove', updateMousePosition);
          document.body.classList.remove('glow-active');
        }, { once: true });
      }

      function initAnimations() {
        const animElements = document.querySelectorAll('[data-animate]');
        animElements.forEach(el => observer.observe(el));
        initGlow();
      }

      function initSkipLink() {
        const skipLink = document.querySelector('.skip-link');
        const mainContent = document.getElementById('main-content');

        if (!skipLink || !mainContent) return;

        if (!mainContent.hasAttribute('tabindex')) {
          mainContent.setAttribute('tabindex', '-1');
        }

        if (skipLink.dataset.bound === 'true') return;
        skipLink.dataset.bound = 'true';

        skipLink.addEventListener('click', (event) => {
          event.preventDefault();

          mainContent.scrollIntoView({ block: 'start', behavior: 'auto' });
          mainContent.focus({ preventScroll: true });

          const nextHash = '#main-content';
          if (window.location.hash !== nextHash) {
            window.history.replaceState(null, '', `${window.location.pathname}${window.location.search}${nextHash}`);
          }
        });
      }

      // Initial run
      initAnimations();
      initSkipLink();

      // Ensure it works with View Transitions
      document.addEventListener('astro:page-load', initAnimations);
      document.addEventListener('astro:page-load', initSkipLink);
    </script>
  </body>
</html>
