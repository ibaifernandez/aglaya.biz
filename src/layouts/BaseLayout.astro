---
import '../styles/global.css';
import ClientRouter from 'astro/components/ClientRouter.astro';
import CookieBanner from '../components/CookieBanner.astro';
import CustomCursor from '../components/CustomCursor.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  lang?: string;
  alternateUrl?: string;
  alternateUrlPt?: string;
}

const {
  title,
  description = 'Digital marketing and brand strategy AI·gency. We build brands that convert.',
  ogImage = '/images/og-default.png',
  ogType = 'website',
  lang = 'en',
  alternateUrl,
  alternateUrlPt,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageAbsolute = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, Astro.site).href;

// Derive EN path to compute alternate URLs
const enUrl = lang === 'en'
  ? canonicalURL.href
  : (alternateUrl ?? new URL('/', Astro.site).href);
const enPath = new URL(enUrl).pathname;

const esUrl = lang === 'es'
  ? canonicalURL.href
  : new URL(enPath === '/' ? '/es/' : `/es${enPath}`, Astro.site).href;

const ptUrl = lang === 'pt'
  ? canonicalURL.href
  : (alternateUrlPt ?? new URL(enPath === '/' ? '/pt/' : `/pt${enPath}`, Astro.site).href);

const ogLocale = lang === 'pt' ? 'pt_BR' : lang === 'es' ? 'es_ES' : 'en_US';
const fullTitle = title;

// Organization LD+JSON structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "AGLAYA",
  "alternateName": "The Uncomfortable Agency",
  "url": "https://aglaya.biz",
  "logo": "https://aglaya.biz/android-chrome-512x512.png",
  "description": "Digital marketing and brand strategy AI·gency focused on conversion.",
  "sameAs": [],
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "info@aglaya.biz",
    "contactType": "customer service"
  }
};

---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#e8003d" />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang — trilingual SEO, no duplicate content -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="pt-BR" href={ptUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AGLAYA — The Uncomfortable Agency" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="AGLAYA" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <meta name="twitter:image:alt" content="AGLAYA — The Uncomfortable Agency" />

    <!-- Favicon suite -->
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-aglaya.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google Fonts: Outfit + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- LD+JSON — Organization structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Client-side navigation (View Transitions API) -->
    <ClientRouter />
  </head>
  <body class="bg-black text-white selection:bg-brand/30 selection:text-white overflow-x-hidden">
    <a href="#main-content" class="skip-link">
      {lang === 'es' ? 'Saltar al contenido principal' : lang === 'pt' ? 'Pular para o conteúdo principal' : 'Skip to main content'}
    </a>
    <slot />
    <CookieBanner lang={lang as 'en' | 'es' | 'pt'} />
    <CustomCursor />

    <script is:inline>
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      // Reactive background logic
      function initGlow() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (window.matchMedia('(hover: none)').matches) return;
        
        const updateMousePosition = (e) => {
          document.documentElement.style.setProperty('--mouse-x', `${e.clientX}px`);
          document.documentElement.style.setProperty('--mouse-y', `${e.clientY}px`);
          
          if (!document.body.classList.contains('glow-active')) {
             document.body.classList.add('glow-active');
          }
        };
        
        window.addEventListener('mousemove', updateMousePosition, { passive: true });
        
        // Cleanup so it doesn't duplicate on page transitions
        document.addEventListener('astro:before-swap', () => {
          window.removeEventListener('mousemove', updateMousePosition);
          document.body.classList.remove('glow-active');
        }, { once: true });
      }

      function initAnimations() {
        const animElements = document.querySelectorAll('[data-animate]');
        animElements.forEach(el => observer.observe(el));
        initGlow();
      }

      // Initial run
      initAnimations();

      // Ensure it works with View Transitions
      document.addEventListener('astro:page-load', initAnimations);
    </script>
  </body>
</html>
