---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import Send from './icons/Send.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const hcaptchaSiteKey = import.meta.env.PUBLIC_HCAPTCHA_SITE_KEY || 'a772dbf8-f0da-4658-a4be-5b0848440ac8';
---

<script is:inline>
  window.onHCaptchaSuccessOpenChannel = function(token) {
    const tokenInput = document.querySelector('#open-channel-form [name="token"]');
    if (tokenInput) tokenInput.value = token;
    document.getElementById('oc-submit')?.removeAttribute('disabled');
  };
  window.onHCaptchaExpiredOpenChannel = function() {
    const tokenInput = document.querySelector('#open-channel-form [name="token"]');
    if (tokenInput) tokenInput.value = '';
    document.getElementById('oc-submit')?.setAttribute('disabled', 'true');
  };
  window.onHCaptchaErrorOpenChannel = function() {
    const tokenInput = document.querySelector('#open-channel-form [name="token"]');
    if (tokenInput) tokenInput.value = '';
    document.getElementById('oc-submit')?.setAttribute('disabled', 'true');
  };
</script>
<script src="https://js.hcaptcha.com/1/api.js" async defer is:inline></script>

<form id="open-channel-form" class="flex flex-col gap-6" data-lang={lang}>
  <input type="hidden" name="icp_status" value="OPEN_CHANNEL" />
  <input type="hidden" name="company" value="" />
  <input type="hidden" name="inquiry_type" value="OPEN_CHANNEL_LEAD" />
  <input type="hidden" name="manual_execution" value="" />
  <input type="hidden" name="data_infrastructure" value="" />
  <input type="hidden" name="growth_investment" value="" />
  <input type="hidden" name="icp_signal_score" value="" />
  <input type="hidden" name="icp_primary_state" value="" />
  <input type="hidden" name="token" value="" />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="flex flex-col gap-2">
      <label for="oc-name" class="font-mono text-[10px] text-white/60 uppercase tracking-widest">{t('contact.form.name')}</label>
      <input type="text" id="oc-name" name="name" required autocomplete="name" class="bg-white/5 border border-white/10 px-6 py-4 text-white font-body outline-none focus:border-brand transition-colors" />
    </div>
    <div class="flex flex-col gap-2">
      <label for="oc-email" class="font-mono text-[10px] text-white/60 uppercase tracking-widest">{t('contact.form.email')}</label>
      <input type="email" id="oc-email" name="email" required autocomplete="email" class="bg-white/5 border border-white/10 px-6 py-4 text-white font-body outline-none focus:border-brand transition-colors" />
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <label for="oc-website" class="font-mono text-[10px] text-white/60 uppercase tracking-widest">{t('contact.form.website')}</label>
    <input type="url" id="oc-website" name="website" placeholder="https://" autocomplete="url" class="bg-white/5 border border-white/10 px-6 py-4 text-white font-body outline-none focus:border-brand transition-colors" />
  </div>

  <div class="flex flex-col gap-2">
    <label for="oc-message" class="font-mono text-[10px] text-white/60 uppercase tracking-widest">{t('contact.form.message')}</label>
    <textarea id="oc-message" name="message" rows="5" required placeholder={t('contact.form.message_placeholder.blocked_investment')} class="bg-white/5 border border-white/10 px-6 py-4 text-white font-body outline-none focus:border-brand transition-colors resize-none"></textarea>
  </div>

  <div class="flex flex-col sm:flex-row items-center justify-between gap-8 mt-4">
    <div
      class="h-captcha"
      data-sitekey={hcaptchaSiteKey}
      data-theme="dark"
      data-callback="onHCaptchaSuccessOpenChannel"
      data-expired-callback="onHCaptchaExpiredOpenChannel"
      data-error-callback="onHCaptchaErrorOpenChannel"
      role="region"
      aria-label="Bot verification"
    ></div>

    <button
      type="submit"
      id="oc-submit"
      disabled
      class="bg-brand text-white px-12 py-5 font-display font-black uppercase tracking-widest flex items-center gap-4 hover:bg-brand-dark transition-all disabled:opacity-50 disabled:cursor-not-allowed w-full sm:w-auto"
    >
      <span>{t('contact.form.submit')}</span>
      <Send class="w-4 h-4" />
    </button>
  </div>

  <div id="oc-error" class="hidden text-brand font-mono text-xs uppercase tracking-widest border border-brand/20 p-4 bg-brand/5" role="alert" aria-live="assertive">
    ERROR_DURING_TRANSMISSION. REATTEMPT_REQUIRED.
  </div>
</form>

<div id="oc-success" class="hidden flex flex-col items-center gap-8 py-20 border border-white/10 bg-[#050505]">
  <div class="w-16 h-16 border-2 border-brand flex items-center justify-center">
    <div class="w-8 h-8 bg-brand animate-pulse"></div>
  </div>
  <h3 class="text-white font-display font-black text-3xl uppercase tracking-tighter">DATA_SYNCHRONIZED</h3>
  <p class="text-white/60 font-body text-center max-w-sm italic">
    {t('contact.success')}
  </p>
</div>

<script>
  const form = document.querySelector('#open-channel-form') as HTMLFormElement;
  const success = document.querySelector('#oc-success');
  const error = document.querySelector('#oc-error');
  const submitButton = form?.querySelector('button') as HTMLButtonElement | null;
  const submitLabel = submitButton?.querySelector('span');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitButton) {
      submitButton.disabled = true;
    }
    if (submitLabel) {
      submitLabel.textContent = 'SYNCHRONIZING...';
    }

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    const lang = form.dataset.lang;

    try {
      const res = await fetch('/.netlify/functions/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...data, lang }),
      });

      if (res.ok) {
        form.classList.add('hidden');
        success?.classList.remove('hidden');
      } else {
        throw new Error('Sync failed');
      }
    } catch (err) {
      error?.classList.remove('hidden');
      if (submitButton) {
        submitButton.disabled = false;
      }
      if (submitLabel) {
        submitLabel.textContent = 'REATTEMPT_SYNC';
      }
    }
  });
</script>
