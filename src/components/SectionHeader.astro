---
interface Props {
  eyebrow?: string;
  heading?: string;
  heading1?: string;
  heading2?: string;
  align?: 'left' | 'center';
  light?: boolean;
  heading2Class?: string;
  spacing?: string; // Tailwind margin utility, e.g. "mb-12"
  gap?: string; 
}

const { eyebrow, heading, heading1, heading2, align = 'left', light = false, heading2Class, spacing = 'mb-16', gap = 'gap-4' } = Astro.props;
const title = heading1 || heading || '';
---

<div class={`flex flex-col ${gap} ${align === 'center' ? 'items-center text-center' : 'items-start text-left'} ${spacing}`}>
  {eyebrow && (
    <span class="text-corporate-green font-mono text-[10px] sm:text-xs font-black tracking-[0.4em] uppercase">
      {eyebrow}
    </span>
  )}
  <h2 class={`font-display font-black text-4xl md:text-6xl lg:text-6xl tracking-tighter leading-[1.1] ${light ? 'text-black' : 'text-white'} whitespace-pre-line uppercase`}>
    {title}
    {heading2 && <span class={heading2Class}>{heading2}</span>}
  </h2>
  <div class="w-12 h-1 bg-brand mt-2"></div>
</div>
