---
/* Custom Cursor — AGLAYA */
---

<div id="custom-cursor" aria-hidden="true"></div>

<script>
  // Only activate on hover-capable devices (not touch-primary)
  if (!window.matchMedia('(hover: none)').matches) {
    function initCursor() {
      const cursor = document.getElementById('custom-cursor') as HTMLElement | null;
      if (!cursor) return;

      document.documentElement.classList.add('custom-cursor-enabled');

      let mouseX = 0, mouseY = 0;
      let cursorX = 0, cursorY = 0;
      let targetScale = 1;
      let currentScale = 1;
      let active = false;
      let raf: number | null = null;

      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

      const tick = () => {
        // Outer ring follows with easing
        cursorX = lerp(cursorX, mouseX, 0.2);
        cursorY = lerp(cursorY, mouseY, 0.2);
        currentScale = lerp(currentScale, targetScale, 0.15);
        
        cursor.style.transform = `translate3d(${cursorX}px,${cursorY}px,0) translate(-50%,-50%) scale(${currentScale})`;
        
        // Inner dot follows instantly for precision (handled via CSS left/top or pseudo-element)
        // Since we want the dot exactly at the pointer, we update its relative position if needed
        // but here we are moving the whole container.
        
        raf = requestAnimationFrame(tick);
      };

      const onMove = (e: MouseEvent) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        
        // Update variables for the inner dot to stay pinned to pointer
        cursor.style.setProperty('--mouse-x', `${mouseX}px`);
        cursor.style.setProperty('--mouse-y', `${mouseY}px`);

        if (!active) {
          active = true;
          cursor.style.opacity = '1';
          cursorX = mouseX;
          cursorY = mouseY;
          raf = requestAnimationFrame(tick);
        }
      };

      const onLeave = () => { cursor.style.opacity = '0'; };
      const onEnter = () => { if (active) cursor.style.opacity = '1'; };

      const onOver = (e: MouseEvent) => {
        const t = e.target as HTMLElement;
        if (t?.closest('a,button,input,textarea,select')) {
          targetScale = 3;
          cursor.classList.add('is-hovering');
        }
      };
      const onOut = (e: MouseEvent) => {
        const t = e.target as HTMLElement;
        if (t?.closest('a,button,input,textarea,select')) {
          targetScale = 1;
          cursor.classList.remove('is-hovering');
        }
      };

      document.addEventListener('mousemove', onMove, { passive: true });
      document.addEventListener('mouseleave', onLeave);
      document.addEventListener('mouseenter', onEnter);
      document.addEventListener('mouseover', onOver);
      document.addEventListener('mouseout', onOut);

      // Cleanup before View Transition swap
      document.addEventListener('astro:before-swap', () => {
        active = false;
        if (raf) { cancelAnimationFrame(raf); raf = null; }
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseleave', onLeave);
        document.removeEventListener('mouseenter', onEnter);
        document.removeEventListener('mouseover', onOver);
        document.removeEventListener('mouseout', onOut);
      }, { once: true });
    }

    // astro:page-load fires on both initial load and every navigation
    document.addEventListener('astro:page-load', initCursor);
  }
</script>

<style is:global>
  #custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 20px;
    height: 20px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: transparent;
    mix-blend-mode: difference;
    pointer-events: none;
    z-index: 10000;
    opacity: 0;
    transition: opacity 0.3s ease, border-color 0.3s ease, background 0.3s ease;
    will-change: transform;
    border-radius: 50% !important;
  }

  /* The central dot */
  #custom-cursor::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4px;
    height: 4px;
    background: white;
    transform: translate(-50%, -50%);
    border-radius: 50% !important;
    transition: transform 0.3s ease;
  }

  /* Interaction states */
  #custom-cursor.is-hovering {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.1);
  }

  #custom-cursor.is-hovering::before {
    transform: translate(-50%, -50%) scale(0.5);
  }

  html.custom-cursor-enabled,
  html.custom-cursor-enabled * {
    cursor: none !important;
  }
</style>
