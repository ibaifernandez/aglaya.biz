---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'proof'>;
  featured?: boolean;
}

const { entry, featured = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { title, client, client_logo, logo, industry, results, solution_systems } = entry.data;

const titleText = typeof title === 'object'
  ? title[lang] || title['en'] || Object.values(title)[0] || ''
  : title || '';

const industryText = typeof industry === 'object'
  ? industry[lang] || industry['en'] || Object.values(industry)[0] || ''
  : industry || '';

const clientLogoSrc = client_logo || logo || '';

// Slug resolution: remove lang prefix if present in ID
const cleanSlug = entry.id.replace(/^(en|es)\//, '');

---

<a
  href={translatePath(`/proof/${cleanSlug}/`)}
  class={`group relative flex ${featured ? 'flex-col lg:flex-row' : 'flex-col'} bg-[#eaeaea]/10 border border-white/5 hover:border-brand/40 transition-all duration-500 overflow-hidden`}
  data-animate="fade-up"
>
  <!-- Header Meta -->
  <div class="deco-text absolute top-6 left-6 right-6 flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.4em] text-white" aria-hidden="true">
    <span>{industryText}</span>
  </div>

  <!-- Content Area -->
  <div class={`flex-1 flex flex-col gap-8 p-10 pt-24 ${featured ? 'lg:py-16 lg:px-6' : ''}`}>

    <!-- Title + Brand -->
    <div class="flex items-center justify-between gap-6">
    <h3 class={`text-white font-display font-black leading-tight tracking-tighter uppercase group-hover:text-brand transition-colors ${featured ? 'text-4xl sm:text-6xl' : 'text-3xl'}`}>
      {titleText}
    </h3>
    {clientLogoSrc ? (
      <img
      src={clientLogoSrc}
      alt={client}
      class="h-24 sm:h-32 max-w-[350px] object-contain"
      loading="lazy"
/>
    ) : (
      <span class="text-white/60 font-mono text-xs tracking-widest uppercase">{client}</span>
    )}
  </div>

    <!-- Systems Mapping -->
    <div class="flex flex-wrap gap-2 mt-auto">
      {solution_systems.map(system => (
        <span class="bg-white/5 border border-white/10 px-3 py-1 font-mono text-[9px] uppercase tracking-widest text-white/60">
          {system}
        </span>
      ))}
    </div>

    <!-- Results / Metrics -->
    <div class={`grid ${featured ? 'grid-cols-2 sm:grid-cols-3' : 'grid-cols-2'} gap-8 pt-8 border-t border-white/10 mt-4`}>
      {results.slice(0, 3).map(result => {
        const labelText = typeof result.label === 'object'
          ? result.label[lang] || result.label['en'] || Object.values(result.label)[0] || ''
          : result.label || '';
        return (
          <div class="flex flex-col gap-2">
            <span class="text-brand font-display font-black text-2xl sm:text-3xl tracking-tighter">
              {result.metric}
            </span>
            <span class="text-white/60 font-mono text-[9px] uppercase tracking-widest leading-tight">
              {labelText}
            </span>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Featured Indicator -->
  {featured && (
    <div class="deco-text absolute top-6 right-6 hidden lg:flex items-center gap-2" aria-hidden="true">
      <div class="w-2 h-2 bg-brand animate-pulse"></div>
      <span class="font-mono text-[10px] text-white/30 uppercase tracking-[0.3em]" aria-hidden="true">{t('proof.featured')}</span>
    </div>
  )}

  <!-- Visual Overlay -->
  <div class="absolute inset-x-0 bottom-0 h-1 bg-white/10 group-hover:bg-brand transition-all duration-700"></div>
</a>