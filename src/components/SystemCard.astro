---
interface Props {
  name: string;
  tagline: string;
  useCases: string;
  index: number;
}

const { name, tagline, useCases, index } = Astro.props;
---

<div 
  class="min-h-full group relative flex flex-col p-10 bg-[#0c0c0c] border border-white/5 hover:border-brand/30 transition-all duration-500 overflow-hidden"
  data-animate="fade-up"
>
  <!-- Industrial Index -->
  <span class="font-mono text-[10px] text-brand uppercase tracking-[0.5em] mb-4">
    ARCHITECTURE_PRINCIPLE_00{index + 1}
  </span>

  <!-- Title & Tagline -->
  <div class="flex flex-col gap-2">
    <h3 class="text-white font-display font-black text-3xl sm:text-4xl tracking-tighter uppercase group-hover:text-brand transition-colors">
      {name}
    </h3>
    <p class="text-muted font-body text-lg italic leading-tight">
      {tagline}
    </p>
  </div>

  <!-- Divider -->
  <div class="w-12 h-[1px] bg-white/10 group-hover:w-full group-hover:bg-brand/20 transition-all duration-700 mt-4"></div>

  <!-- Use Cases -->
  <div class="flex flex-col gap-4 mt-4">
    <span class="text-corporate-green font-mono text-[8px] uppercase tracking-[0.5em]">APPLIED_LOGIC:</span>
    <ul class="flex flex-col flex-wrap gap-x-6 gap-y-3">
      {useCases.split(', ').map(useCase => (
        <li class="text-muted font-mono text-[11px] uppercase tracking-[0.1em] flex items-center gap-2 before:content-[''] before:w-1.5 before:h-1.5 before:bg-brand/40 before:shrink-0 before:hover:bg-brand transition-colors">
          {useCase}
        </li>
      ))}
    </ul>
  </div>

  <!-- Background Scanline Effect -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none group-hover:opacity-[0.07] transition-opacity">
    <div class="absolute inset-0 bg-gradient-to-br from-brand to-transparent"></div>
    <div class="h-full w-full bg-[size:100%_4px] bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%)]"></div>
  </div>
</div>
