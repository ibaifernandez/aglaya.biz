---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  checkboxId: string;
  variant: 'contact' | 'dispatch';
}

const { checkboxId, variant } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const privacyPath =
  lang === 'es' ? '/es/privacidad/' : lang === 'pt' ? '/pt/privacidade/' : '/privacy/';
const cookiesPath = translatePath('/cookies/');

const label =
  variant === 'dispatch'
    ? t('footer.dispatch.consent_label')
    : t('contact.form.consent_label');

const note =
  variant === 'dispatch'
    ? t('footer.dispatch.consent_note')
    : t('contact.form.consent_note');
---

<div class="border border-white/10 bg-white/[0.02] px-4 py-4">
  <label for={checkboxId} class="flex cursor-pointer items-start gap-3">
    <input
      id={checkboxId}
      type="checkbox"
      name="privacy_consent"
      value="true"
      required
      aria-describedby={`${checkboxId}-note`}
      class="mt-1 h-4 w-4 shrink-0 cursor-pointer accent-brand"
    />
    <span class="text-white/78 font-body text-sm leading-relaxed">
      {label}
    </span>
  </label>

  <p id={`${checkboxId}-note`} class="mt-3 pl-7 text-white/46 font-body text-xs leading-relaxed">
    {note}
    {' '}
    <a href={privacyPath} class="text-white/72 underline underline-offset-2 transition-colors hover:text-white">
      {t('nav.privacy')}
    </a>
    <span class="px-2 text-white/18">/</span>
    <a href={cookiesPath} class="text-white/72 underline underline-offset-2 transition-colors hover:text-white">
      {t('nav.cookies')}
    </a>
  </p>
</div>
