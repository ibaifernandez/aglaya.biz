---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import logoBlanco from '../assets/images/aglaya-logo-blanco.svg?raw';
import DispatchSignupForm from './DispatchSignupForm.astro';

interface Props {
  wide?: boolean;
}
const { wide = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentYear = new Date().getFullYear();

const privacyPath =
  lang === 'es' ? '/es/privacidad' : lang === 'pt' ? '/pt/privacidade' : '/privacy';
const cookiesPath = translatePath('/cookies');
const avisoLegalPath = lang === 'es' ? '/es/aviso-legal' : lang === 'pt' ? '/pt/aviso-legal' : '/legal-notice';

const primaryLinks = [
  {
    href: translatePath('/roi-audit/'),
    label: t('nav.roi_audit'),
    description: t('footer.links.roi_audit'),
  },
  {
    href: translatePath('/the-stack/'),
    label: t('nav.the_stack'),
    description: t('footer.links.services'),
  },
  {
    href: translatePath('/contact'),
    label: t('nav.contact'),
    description: t('footer.links.contact'),
  },
];
---

<footer class="relative overflow-hidden border-t border-white/8 bg-[#040404] pt-20 pb-10">
  <script>
  document.getElementById('footer-cookie-reset')?.addEventListener('click', () => {
    localStorage.removeItem('aglaya_cookie_consent');
    const banner = document.getElementById('cookie-banner');
    if (banner) {
      banner.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => banner.classList.add('is-visible')));
    }
  });
  </script>
  <div class="absolute inset-0 bg-grid opacity-15 pointer-events-none"></div>
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/12 to-transparent pointer-events-none"></div>

  <div class={`relative z-10 mx-auto flex flex-col gap-16 px-6 sm:px-10 lg:px-20 ${wide ? 'max-w-[1600px]' : 'max-w-7xl'}`}>
    <div class="grid gap-12 xl:grid-cols-[minmax(0,1.55fr)_minmax(320px,0.9fr)] xl:gap-16 items-start">
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-6 max-w-3xl">
          <a href={translatePath('/')} class="flex w-fit flex-col gap-[3px] group" aria-label="AGLAYA Home">
            <div class="h-6 w-auto transition-opacity group-hover:opacity-80 [&_svg]:h-6 [&_svg]:w-auto [&_.st0]:fill-white">
              <Fragment set:html={logoBlanco} />
            </div>
          </a>

          <div class="flex flex-col gap-4">
            <span class="font-mono text-[10px] uppercase tracking-[0.42em] text-corporate-green">
              {t('footer.dispatch.eyebrow')}
            </span>
            <h2 class="max-w-3xl text-white font-display text-4xl md:text-5xl font-black uppercase tracking-tight leading-[0.92]">
              {t('footer.dispatch.heading')}
            </h2>
            <p class="max-w-2xl text-white/62 font-body text-lg leading-relaxed">
              {t('footer.dispatch.body')}
            </p>
          </div>
        </div>

        <div class="max-w-2xl border border-white/10 bg-white/[0.025] p-6 md:p-8">
          <DispatchSignupForm />
        </div>

      </div>

      <div class="border border-white/10 bg-white/[0.02] p-6 md:p-8">
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-3">
            <span class="font-mono text-[10px] uppercase tracking-[0.38em] text-white/35">
              {t('footer.links.eyebrow')}
            </span>
            <p class="max-w-sm text-white/52 font-body text-sm leading-relaxed">
              {t('footer.links.body')}
            </p>
          </div>

          <div class="flex flex-col divide-y divide-white/8 border-y border-white/8">
            {primaryLinks.map((link) => (
              <a
                href={link.href}
                class="group flex items-start justify-between gap-5 py-5 transition-colors hover:text-white focus-visible:outline-none"
              >
                <div class="flex min-w-0 flex-col gap-2">
                  <span class="text-white font-display text-lg font-black uppercase tracking-[0.04em] transition-colors group-hover:text-brand-light">
                    {link.label}
                  </span>
                  <span class="text-white/46 font-body text-sm leading-relaxed transition-colors group-hover:text-white/62">
                    {link.description}
                  </span>
                </div>
                <span class="mt-1 shrink-0 text-white/26 font-mono text-xs uppercase tracking-[0.28em] transition-colors group-hover:text-brand-light">
                  [GO]
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-6 border-t border-white/8 pt-6 md:flex-row md:items-center md:justify-between">
      <p class="text-white/34 font-mono text-[10px] uppercase tracking-[0.24em] leading-relaxed">
        {t('footer.bottom')}
      </p>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href={privacyPath} class="text-white/42 hover:text-white font-display text-[11px] font-bold uppercase tracking-[0.18em] transition-colors">
          {t('nav.privacy')}
        </a>
        <a href={cookiesPath} class="text-white/42 hover:text-white font-display text-[11px] font-bold uppercase tracking-[0.18em] transition-colors">
          {t('nav.cookies')}
        </a>
        <a href={avisoLegalPath} class="text-white/42 hover:text-white font-display text-[11px] font-bold uppercase tracking-[0.18em] transition-colors">
          {t('nav.legal_notice')}
        </a>
        <button
          id="footer-cookie-reset"
          type="button"
          class="text-white/42 hover:text-white font-display text-[11px] font-bold uppercase tracking-[0.18em] transition-colors cursor-pointer bg-transparent border-none p-0"
        >
          {t('footer.cookie_preferences')}
        </button>
        <span class="text-white/22 font-mono text-[10px] uppercase tracking-[0.2em]">
          © {currentYear} AGLAYA
        </span>
      </div>
    </div>
  </div>
</footer>
