---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import ProofCard from './ProofCard.astro';
import SectionHeader from './SectionHeader.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Get all proof entries (flat collection — no lang-prefix subdirectory)
const allEntries = await getCollection('proof');
const entries = allEntries
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

// 1-2-1 layout: featured top · two mid · featured-2 bottom
// Add card IDs here as they're built and ready.
const featured  = entries.find(e => e.id === 'legal-reg-tech') ?? entries[0];
const MID_IDS   = ['elm-st-web', 'bill-capital'];
const midCards  = MID_IDS.map(id => entries.find(e => e.id === id)).filter(Boolean);
const featured2 = entries.find(e => e.id === 'kanban-desk') ?? null;
---

<section
  id="proof"
  class="px-6 py-20 sm:px-10 lg:px-20 bg-black border-t border-white/5"
>
  <div class="max-w-7xl mx-auto flex flex-col gap-16">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-end gap-10" data-animate="fade-up">
      <SectionHeader
        eyebrow={t('proof.eyebrow')}
        heading={t('proof.heading')}
      />
      <!-- <a
        href={translatePath('/proof/')}
        class="text-corporate-green font-mono text-xs uppercase tracking-[0.4em] hover:text-white transition-colors mb-4 flex items-center gap-4 group border py-5 px-12"
      >
        <span style="display:block;width:280px;">DISCOVER_FULL_INDEX &gt;&gt;&gt;</span>
        <div class="w-8 h-[1px] bg-brand group-hover:w-12 transition-all"></div> -->
    </a>
    </div>

    <!-- Proof Layout: 1 · 2 · 1 -->
    <div class="flex flex-col gap-8">
      {featured && (
        <ProofCard entry={featured} featured />
      )}

      <div class="flex flex-col md:flex-row gap-8">
        {midCards.map(entry => (
          <div class="flex-1">
            <ProofCard entry={entry} />
          </div>
        ))}
      </div>

      {featured2 && (
        <ProofCard entry={featured2} featured />
      )}
    </div>

    <!-- Final CTA Area -->
    <div class="flex flex-col items-center gap-8 text-center" data-animate="fade-up">
      <div class="w-px h-24 bg-gradient-to-b from-brand to-transparent"></div>
      <p class="codetag-50 deco-text text-white/40 font-mono text-xs uppercase tracking-[0.5em]" aria-hidden="true">STATUS: VALIDATION_COMPLETE</p>
      <a
        href={translatePath('/contact/')}
        class="group bg-white text-black px-12 py-6 font-display font-black uppercase text-xl transition-all hover:bg-brand hover:text-white"
      >
        {t('proof.cta')}
      </a>
    </div>
  </div>
</section>