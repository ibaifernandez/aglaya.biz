---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import SectionHeader from './SectionHeader.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section 
  id="problem" 
  class="px-6 py-20 sm:px-10 lg:px-20 border-t border-white/5 bg-black"
>
  <div class="max-w-7xl mx-auto flex flex-col gap-12">
    <!-- Header -->
     <div class="flex items-center mt-20 gap-4 overflow-hidden" data-animate="fade-up">
        <div class="w-8 h-[1px] bg-brand"></div>
        <span class="text-corporate-green font-mono text-[10px] sm:text-xs font-black tracking-[0.5em] uppercase">
            {t('problem.eyebrow')} 
        </span>
    </div>
    <div class="flex align-center gap-4" data-animate="fade-up">
        <div data-animate="fade-up">
            <SectionHeader 
            heading1={t('problem.heading1')}
            heading2={t('problem.heading2')}
            heading2Class="text-brand"
            />
        </div>
    </div>

    <!-- Grid of Problem Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {[1, 2, 3, 4, 5, 6].map((i) => (
        <div 
          class="group relative flex flex-col p-8 bg-surface-2 border border-white/5 hover:border-brand/40 transition-all duration-500 overflow-hidden"
          data-animate="fade-up"
          style={`animation-delay: ${i * 100}ms`}
        >
          <!-- Card Index/ID -->
          <div class="flex justify-between items-start mb-6">
            <span class="font-mono text-[9px] text-corporate-green uppercase tracking-[0.4em] opacity-70">
              LOGIC_NODE_00{i}
            </span>
            <div class="w-1 h-1 bg-brand/40 group-hover:bg-brand transition-colors"></div>
          </div>

          <!-- Card Content -->
          <h3 class="text-white font-display font-black text-xl sm:text-2xl tracking-tighter uppercase mb-4 group-hover:text-brand transition-colors duration-300">
            {t(`problem.grid.${i}.title`)}
          </h3>
          
          <p class="text-white/40 font-body text-sm sm:text-base leading-relaxed group-hover:text-white/70 transition-colors duration-500">
            {t(`problem.grid.${i}.body`)}
          </p>

          <!-- Decorative Line -->
          <div class="mt-8 w-8 h-[1px] bg-white/10 group-hover:w-full group-hover:bg-brand/20 transition-all duration-700"></div>

          <!-- Background Subtle Scanline (Premium Detail) -->
          <div class="absolute inset-0 opacity-[0.02] pointer-events-none group-hover:opacity-[0.05] transition-opacity duration-700">
            <div class="absolute inset-0 bg-gradient-to-br from-brand/20 to-transparent"></div>
            <div class="h-full w-full bg-[size:100%_2px] bg-[linear-gradient(color-mix(in_srgb,var(--color-brand)_10%,transparent)_50%,rgba(0,0,0,0)_50%)]"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Accent Detail -->
    <div class="deco-text my-20 opacity-50 font-mono text-[10px] uppercase tracking-[0.5em] text-white flex justify-end items-center gap-6" data-animate="fade-up" aria-hidden="true">
      <span class="codetag">REF_ID: 001_SOVEREIGNTY_LOGIC</span>
      <div class="flex gap-1">
        {[...Array(5)].map(() => (
          <div class="w-1.5 h-1.5 bg-corporate-green"></div>
        ))}
      </div>
    </div>
  </div>
</section>
