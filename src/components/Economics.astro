---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import SectionHeader from './SectionHeader.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="economics" class="bg-black py-40 border-t border-white/5 relative overflow-hidden group">
  
  <!-- Massive Background Accent -->
  <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-brand/5 blur-[150px] rounded-full translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10 flex flex-col gap-24">
    
    <!-- Header -->
    <div data-animate="fade-up">
      <SectionHeader 
        eyebrow={t('eco.eyebrow')} 
        heading={t('eco.heading')} 
        align="center"
      />
    </div>

    <!-- The Economic Formula -->
    <div 
      class="max-w-5xl mx-auto w-full bg-[#050505] border border-white/10 p-12 lg:p-24 flex flex-col items-center gap-16 relative group/formula hover:border-brand/40 transition-all duration-700"
      data-animate="fade-up"
    >
      <!-- Industrial Meta -->
      <div class="absolute top-6 left-6 font-mono text-[8px] text-white/20 uppercase tracking-[0.5em]">
        ASSET_VALUATION_PROJECTION_v4.2
      </div>
      <div class="absolute top-6 right-6 flex gap-2">
        <div class="w-2 h-2 bg-brand/20 group-hover/formula:bg-brand transition-colors"></div>
        <div class="w-10 h-2 bg-white/5 group-hover/formula:bg-white/10 transition-colors"></div>
      </div>

      <!-- Main Equation -->
      <div class="flex flex-col md:flex-row items-center justify-center gap-12 w-full">
        <!-- Input -->
        <div class="flex flex-col items-center gap-4 text-center">
          <span class="text-white font-display font-black text-3xl sm:text-4xl uppercase tracking-tighter">AGLAYA SYSTEM</span>
          <span class="px-3 py-1 bg-brand/20 text-brand font-mono text-[10px] uppercase tracking-widest">FIXED_ASSET</span>
        </div>

        <!-- Operator -->
        <div class="text-brand font-display font-black text-6xl opacity-40">>></div>

        <!-- Output -->
        <div class="flex flex-col items-center gap-4 text-center">
          <div class="flex flex-col">
            <span class="text-white font-display font-black text-3xl sm:text-4xl uppercase tracking-tighter">12X MANUAL ROI</span>
            <span class="text-brand font-display font-black text-2xl uppercase tracking-widest">+ SOVEREIGNTY</span>
          </div>
          <span class="px-3 py-1 bg-white/5 text-white/40 font-mono text-[10px] uppercase tracking-widest">NET_GAIN_RECOVERY</span>
        </div>
      </div>

      <!-- Narrative -->
      <div class="max-w-2xl text-center">
        <p class="text-white/60 text-xl sm:text-2xl font-body leading-relaxed italic">
          "{t('eco.body')}"
        </p>
      </div>

      <!-- Signature Line -->
      <div class="w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
      
      <div class="font-mono text-[9px] uppercase tracking-[0.4em] text-white/20 flex items-center gap-8">
        <span>STRATEGIC_ASSET: TRUE</span>
        <span>RECURRING_FEES: 0.00</span>
        <span>HUMAN_DEPENDENCY: ELIMINATED</span>
      </div>
    </div>

    <!-- Final Small Proof -->
    <div class="flex flex-col items-center gap-6 opacity-30 group-hover:opacity-60 transition-opacity" data-animate="fade-up">
       <div class="w-px h-16 bg-brand"></div>
       <p class="font-mono text-[10px] uppercase tracking-[0.5em] text-white">Marketing is an expense. Systems are infrastructure.</p>
    </div>
  </div>
</section>
