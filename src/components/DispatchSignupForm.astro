---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import Send from './icons/Send.astro';
import FormComplianceNotice from './FormComplianceNotice.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const hcaptchaSiteKey = import.meta.env.PUBLIC_HCAPTCHA_SITE_KEY || 'a772dbf8-f0da-4658-a4be-5b0848440ac8';
---

<script>
  window.updateDispatchSubmitState = function() {
    const tokenInput = document.querySelector('#dispatch-form [name="token"]');
    const consentInput = document.querySelector('#dispatch-form [name="privacy_consent"]');
    const submitButton = document.getElementById('dispatch-submit');
    const hasToken = Boolean(tokenInput && tokenInput.value);
    const hasConsent = Boolean(consentInput && consentInput.checked);
    if (submitButton) submitButton.toggleAttribute('disabled', !(hasToken && hasConsent));
  };
  window.onHCaptchaSuccessDispatch = function(token) {
    const tokenInput = document.querySelector('#dispatch-form [name="token"]');
    if (tokenInput) tokenInput.value = token;
    window.updateDispatchSubmitState?.();
  };
  window.onHCaptchaExpiredDispatch = function() {
    const tokenInput = document.querySelector('#dispatch-form [name="token"]');
    if (tokenInput) tokenInput.value = '';
    window.updateDispatchSubmitState?.();
  };
  window.onHCaptchaErrorDispatch = function() {
    const tokenInput = document.querySelector('#dispatch-form [name="token"]');
    if (tokenInput) tokenInput.value = '';
    window.updateDispatchSubmitState?.();
  };
</script>
<script src="https://js.hcaptcha.com/1/api.js" async defer is:inline></script>

<form
  id="dispatch-form"
  class="flex flex-col gap-4"
  data-lang={lang}
  data-syncing-label={t('footer.dispatch.syncing')}
  data-synced-label={t('footer.dispatch.synced')}
  data-retry-label={t('footer.dispatch.retry')}
  aria-label={t('footer.dispatch.eyebrow')}
>
  <div class="grid gap-3 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1fr)_auto]">
    <div class="flex flex-col gap-2">
      <label for="dispatch-name" class="font-mono text-[10px] uppercase tracking-[0.28em] text-white/45">
        {t('footer.dispatch.name_label')}
      </label>
      <input
        id="dispatch-name"
        type="text"
        name="name"
        autocomplete="given-name"
        placeholder={t('footer.dispatch.name_placeholder')}
        class="w-full border border-white/10 bg-white/[0.03] px-5 py-4 text-white font-body text-sm outline-none transition-colors placeholder:text-white/28 focus:border-brand"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label for="dispatch-email" class="font-mono text-[10px] uppercase tracking-[0.28em] text-white/45">
        {t('footer.dispatch.email_label')}
      </label>
      <input
        id="dispatch-email"
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder={t('footer.dispatch.email_placeholder')}
        class="w-full border border-white/10 bg-white/[0.03] px-5 py-4 text-white font-body text-sm outline-none transition-colors placeholder:text-white/28 focus:border-brand"
      />
    </div>

    <button
      type="submit"
      id="dispatch-submit"
      disabled
      class="mt-[1.5rem] inline-flex items-center justify-center gap-3 border border-brand bg-brand px-6 py-4 text-white font-display text-[11px] font-black uppercase tracking-[0.2em] transition-all hover:bg-brand-dark hover:border-brand-dark disabled:cursor-not-allowed disabled:opacity-45"
    >
      <span id="dispatch-submit-text">{t('footer.dispatch.submit')}</span>
      <Send class="h-4 w-4" />
    </button>
  </div>

  <input type="hidden" name="token" value="" />

  <input
    type="text"
    name="company"
    tabindex="-1"
    autocomplete="off"
    class="sr-only"
    aria-hidden="true"
  />

  <div
    class="h-captcha"
    data-sitekey={hcaptchaSiteKey}
    data-theme="dark"
    data-callback="onHCaptchaSuccessDispatch"
    data-expired-callback="onHCaptchaExpiredDispatch"
    data-error-callback="onHCaptchaErrorDispatch"
    role="region"
    aria-label={t('contact.form.bot_verification')}
  ></div>

  <FormComplianceNotice checkboxId="dispatch-privacy-consent" variant="dispatch" />

  <p class="text-white/45 font-body text-sm leading-relaxed">
    {t('footer.dispatch.note')}
  </p>

  <div
    id="dispatch-error"
    class="hidden border border-brand/20 bg-brand/5 px-4 py-3 text-brand-light font-mono text-[10px] uppercase tracking-[0.18em]"
    role="alert"
    aria-live="assertive"
  >
    {t('footer.dispatch.error')}
  </div>

  <div
    id="dispatch-success"
    class="hidden border border-corporate-green/25 bg-corporate-green/8 px-4 py-3 text-corporate-green font-mono text-[10px] uppercase tracking-[0.18em]"
    role="status"
    aria-live="polite"
  >
    {t('footer.dispatch.success')}
  </div>
</form>

<script>
  const form = document.querySelector('#dispatch-form') as HTMLFormElement | null;
  const error = document.querySelector('#dispatch-error');
  const success = document.querySelector('#dispatch-success');
  const submitButton = document.querySelector('#dispatch-submit') as HTMLButtonElement | null;
  const submitText = document.querySelector('#dispatch-submit-text');
  const consentInput = form?.querySelector('[name="privacy_consent"]') as HTMLInputElement | null;
  const track = (eventName: string, payload: Record<string, unknown> = {}) => {
    window.dispatchEvent(new CustomEvent('aglaya:track', {
      detail: { event: eventName, payload },
    }));
  };

  const syncSubmitState = () => {
    window.updateDispatchSubmitState?.();
  };

  consentInput?.addEventListener('change', syncSubmitState);
  syncSubmitState();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    error?.classList.add('hidden');
    success?.classList.add('hidden');

    if (!submitButton || !submitText) return;

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());
    const hasName = Boolean(String(payload.name ?? '').trim());

    submitButton.disabled = true;
    submitText.textContent = form.dataset.syncingLabel ?? 'SYNCING...';
    track('dispatch_signup_attempted', {
      form_type: 'dispatch',
      form_location: 'footer',
      language: form.dataset.lang ?? 'en',
      has_name: hasName,
    });

    try {
      const response = await fetch('/.netlify/functions/dispatch-subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...payload,
          lang: form.dataset.lang,
        }),
      });

      if (!response.ok) {
        throw new Error('Dispatch signup failed');
      }

      form.reset();
      success?.classList.remove('hidden');
      submitText.textContent = form.dataset.syncedLabel ?? 'SYNCED';
      track('dispatch_signup_succeeded', {
        form_type: 'dispatch',
        form_location: 'footer',
        language: form.dataset.lang ?? 'en',
        has_name: hasName,
      });
    } catch (signupError) {
      error?.classList.remove('hidden');
      submitText.textContent = form.dataset.retryLabel ?? 'RETRY_SYNC';
      syncSubmitState();
      track('dispatch_signup_failed', {
        form_type: 'dispatch',
        form_location: 'footer',
        language: form.dataset.lang ?? 'en',
        has_name: hasName,
      });
    }
  });
</script>
