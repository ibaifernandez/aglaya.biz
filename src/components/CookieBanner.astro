---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/translations';

interface Props {
  lang?: Lang | 'pt';
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const policyUrl  = lang === 'es' ? '/es/cookies/' : lang === 'pt' ? '/pt/cookies/' : '/cookies/';
const privacyUrl = lang === 'es' ? '/es/privacidad/' : lang === 'pt' ? '/pt/privacidade/' : '/privacy/';
---

<div
  id="cookie-banner"
  class="ck-banner"
  role="region"
  aria-label={lang === 'es' ? 'Aviso de cookies' : 'Cookie notice'}
  aria-live="polite"
  hidden
>
  <!-- Red top accent bar -->
  <div class="ck-bar" aria-hidden="true"></div>

  <div class="ck-inner">
    <div class="ck-text">
      <p class="ck-eyebrow">// COOKIES</p>
      <p class="ck-message">
        {t('cookie.message')}
        {' '}
        <a href={policyUrl} class="ck-link">{t('cookie.policy_link')}</a>
        {' · '}
        <a href={privacyUrl} class="ck-link">{t('cookie.privacy_link')}</a>
      </p>
    </div>

    <div class="ck-actions">
      <button id="cookie-essential" class="ck-btn ck-btn--ghost" type="button">
        {t('cookie.essential')}
      </button>
      <button id="cookie-accept" class="ck-btn ck-btn--primary" type="button">
        {t('cookie.accept')}
      </button>
      <button id="cookie-reject" class="ck-btn ck-btn--muted" type="button" aria-label={t('cookie.reject')}>
        ✕
      </button>
    </div>
  </div>
</div>

<style>
.ck-banner {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  background: #0d0d0d;
  border-top: 1px solid #1f1f1f;
  box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.6);
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.ck-banner.is-visible {
  transform: translateY(0);
}

.ck-bar {
  height: 3px;
  background: #e8003d;
}

.ck-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  max-width: 80rem; /* same as max-w-7xl */
  margin: 0 auto;
  padding: 1rem 1.5rem;
}

.ck-text {
  flex: 1;
  min-width: 0;
}

.ck-eyebrow {
  margin: 0 0 0.25rem;
  font-family: 'Courier New', monospace;
  font-size: 10px;
  letter-spacing: 0.2em;
  color: #ff4d6e;
}

.ck-message {
  margin: 0;
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  line-height: 1.6;
  color: rgba(245, 245, 245, 0.6);
}

.ck-link {
  color: rgba(245, 245, 245, 0.5);
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: color 0.15s;
}
.ck-link:hover { color: #fff; }

.ck-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
}

.ck-btn {
  padding: 0.625rem 1.25rem;
  font-family: 'Outfit', sans-serif;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  border: none;
  cursor: pointer;
  transition: transform 0.15s, box-shadow 0.2s, opacity 0.2s;
  white-space: nowrap;
}

.ck-btn:hover { transform: translateY(-1px); }
.ck-btn:active { transform: scale(0.98); }

.ck-btn--primary {
  background: #e8003d;
  color: #fff;
}
.ck-btn--primary:hover {
  box-shadow: 0 4px 20px rgba(232, 0, 61, 0.45);
}

.ck-btn--ghost {
  background: transparent;
  color: rgba(245, 245, 245, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.15);
}
.ck-btn--ghost:hover {
  color: rgba(245, 245, 245, 0.9);
  border-color: rgba(255, 255, 255, 0.3);
}

/* Reject X button */
.ck-btn--muted {
  background: transparent;
  color: rgba(245, 245, 245, 0.3);
  padding: 0.625rem 0.75rem;
  font-size: 14px;
  letter-spacing: 0;
}
.ck-btn--muted:hover {
  color: rgba(245, 245, 245, 0.7);
}

@media (max-width: 640px) {
  .ck-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
  }
  .ck-actions {
    width: 100%;
  }
  .ck-btn--primary,
  .ck-btn--ghost {
    flex: 1;
    text-align: center;
  }
}
</style>

<script>
(function () {
  const STORAGE_KEY = 'aglaya_cookie_consent';
  const banner = document.getElementById('cookie-banner');
  if (!banner) return;

  if (localStorage.getItem(STORAGE_KEY)) return;

  banner.hidden = false;
  requestAnimationFrame(() => {
    requestAnimationFrame(() => banner.classList.add('is-visible'));
  });

  function dismiss(value: string) {
    if (!banner) return;
    localStorage.setItem(STORAGE_KEY, value);
    window.dispatchEvent(new CustomEvent('aglaya:consent-update', { detail: { consent: value } }));
    banner.classList.remove('is-visible');
    banner.addEventListener(
      'transitionend',
      () => { if (banner) banner.hidden = true; },
      { once: true }
    );
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => dismiss('all'));
  document.getElementById('cookie-essential')?.addEventListener('click', () => dismiss('essential'));
  document.getElementById('cookie-reject')?.addEventListener('click', () => dismiss('rejected'));
})();
</script>
