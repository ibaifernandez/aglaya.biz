---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import QualifiedForm from './QualifiedForm.astro';
import BorderlineForm from './BorderlineForm.astro';
import OpenChannelForm from './OpenChannelForm.astro';

interface Props {
  inquiryTypeOverride?: string;
  entryPoint?: string;
  serviceInterest?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const {
  inquiryTypeOverride = '',
  entryPoint = '',
  serviceInterest = '',
}: Props = Astro.props;

const dataOptions = [
  {
    id: 'icp-data-none',
    value: 'none',
    label: t('contact.qualify.data_option_none'),
    hint: t('contact.qualify.data_option_none_hint'),
  },
  {
    id: 'icp-data-sheet',
    value: 'spreadsheet',
    label: t('contact.qualify.data_option_sheet'),
    hint: t('contact.qualify.data_option_sheet_hint'),
  },
  {
    id: 'icp-data-crm',
    value: 'crm',
    label: t('contact.qualify.data_option_crm'),
    hint: t('contact.qualify.data_option_crm_hint'),
  },
  {
    id: 'icp-data-lake',
    value: 'lake',
    label: t('contact.qualify.data_option_lake'),
    hint: t('contact.qualify.data_option_lake_hint'),
  },
] as const;

const investmentOptions = [
  {
    id: 'icp-investment-0',
    value: 'under_5',
    label: t('contact.qualify.investment_option_0'),
    hint: t('contact.qualify.investment_option_0_hint'),
  },
  {
    id: 'icp-investment-1',
    value: 'between_5_15',
    label: t('contact.qualify.investment_option_1'),
    hint: t('contact.qualify.investment_option_1_hint'),
  },
  {
    id: 'icp-investment-2',
    value: 'between_15_40',
    label: t('contact.qualify.investment_option_2'),
    hint: t('contact.qualify.investment_option_2_hint'),
  },
  {
    id: 'icp-investment-3',
    value: 'over_40',
    label: t('contact.qualify.investment_option_3'),
    hint: t('contact.qualify.investment_option_3_hint'),
  },
] as const;

const icpUi = {
  unset: t('contact.qualify.unset'),
  scoreLabel: t('contact.qualify.score_label'),
  states: {
    incomplete: {
      title: t('contact.qualify.state.incomplete.title'),
      body: t('contact.qualify.state.incomplete.body'),
      button: t('contact.qualify.button.incomplete'),
    },
    blocked_investment: {
      title: t('contact.qualify.state.blocked_investment.title'),
      body: t('contact.qualify.state.blocked_investment.body'),
      button: t('contact.qualify.button.blocked_investment'),
    },
    blocked_data: {
      title: t('contact.qualify.state.blocked_data.title'),
      body: t('contact.qualify.state.blocked_data.body'),
      button: t('contact.qualify.button.blocked_data'),
    },
    blocked_manual: {
      title: t('contact.qualify.state.blocked_manual.title'),
      body: t('contact.qualify.state.blocked_manual.body'),
      button: t('contact.qualify.button.blocked_manual'),
    },
    borderline: {
      title: t('contact.qualify.state.borderline.title'),
      body: t('contact.qualify.state.borderline.body'),
      button: t('contact.qualify.button.borderline'),
    },
    qualified: {
      title: t('contact.qualify.state.qualified.title'),
      body: t('contact.qualify.state.qualified.body'),
      button: t('contact.qualify.button.qualified'),
    },
  },
  audit: {
    manual: {
      low: t('contact.qualify.audit.manual.low'),
      mid: t('contact.qualify.audit.manual.mid'),
      high: t('contact.qualify.audit.manual.high'),
    },
    data: {
      none: t('contact.qualify.audit.data.none'),
      spreadsheet: t('contact.qualify.audit.data.sheet'),
      crm: t('contact.qualify.audit.data.crm'),
      lake: t('contact.qualify.audit.data.lake'),
    },
    investment: {
      under_5: t('contact.qualify.audit.investment.0'),
      between_5_15: t('contact.qualify.audit.investment.1'),
      between_15_40: t('contact.qualify.audit.investment.2'),
      over_40: t('contact.qualify.audit.investment.3'),
    },
  },
  forms: {
    roiAuditPlaceholder: t('contact.form.message_placeholder.roi_audit'),
    blockedPlaceholders: {
      blocked_investment: t('contact.form.message_placeholder.blocked_investment'),
      blocked_data: t('contact.form.message_placeholder.blocked_data'),
      blocked_manual: t('contact.form.message_placeholder.blocked_manual'),
    },
  },
};
---

<div
  id="icp-container"
  class="mx-auto w-full bg-[#050505] border border-white/10 p-8 md:p-16 relative overflow-hidden lg:overflow-visible transition-all duration-700"
  data-state="incomplete"
  data-inquiry-type-override={inquiryTypeOverride}
  data-entry-point={entryPoint}
  data-service-interest={serviceInterest}
>
  <div id="icp-copy" data-json={encodeURIComponent(JSON.stringify(icpUi))} hidden></div>

  <!-- Step 1: Stress Test -->
  <div id="icp-step-1" class="flex flex-col gap-12 transition-opacity duration-500">
    <div class="flex flex-col gap-4 text-center max-w-3xl mx-auto">
      <span class="text-corporate-green font-mono text-[10px] uppercase tracking-[0.5em]">{t('contact.qualify.eyebrow')}</span>
      <h2 class="text-white font-display font-black text-4xl md:text-5xl uppercase tracking-tighter">{t('contact.qualify.heading')}</h2>
      <p class="text-white/60 font-body text-lg md:text-xl leading-relaxed">
        {t('contact.qualify.intro')}
      </p>
    </div>

    <div class="grid gap-8 xl:gap-10 lg:grid-cols-[minmax(0,1.95fr)_minmax(320px,1fr)] items-start">
      <div class="flex flex-col gap-8">
        <div class="icp-panel icp-panel--manual border border-white/8 p-6 md:p-8 flex flex-col gap-5">
          <label for="icp-manual" class="text-white/70 font-mono text-[11px] uppercase tracking-widest flex justify-between gap-4">
            <span>{t('contact.qualify.manual_label')}</span>
            <span id="manual-val" class="icp-value-chip text-[#ff4d70] font-black">{t('contact.qualify.unset')}</span>
          </label>
          <p class="text-white/55 font-body text-sm md:text-base leading-relaxed max-w-3xl">
            {t('contact.qualify.manual_caption')}
          </p>
          <input
            type="range"
            id="icp-manual"
            min="0"
            max="100"
            step="5"
            value="50"
            class="w-full icp-range"
          />
          <div class="flex justify-between font-mono text-[9px] text-white/60 uppercase tracking-[0.22em]" aria-hidden="true">
            <span>{t('contact.qualify.manual_range_1')}</span>
            <span>{t('contact.qualify.manual_range_2')}</span>
            <span>{t('contact.qualify.manual_range_3')}</span>
          </div>
        </div>

        <div class="grid gap-8 lg:grid-cols-2">
          <fieldset class="icp-panel icp-panel--data border border-white/8 p-6 md:p-8 flex flex-col gap-5">
            <legend class="text-white/70 font-mono text-[11px] uppercase tracking-widest px-2">{t('contact.qualify.data_label')}</legend>
            <p class="text-white/55 font-body text-sm md:text-base leading-relaxed height-min-90px">
              {t('contact.qualify.data_caption')}
            </p>
            <div class="grid gap-3 sm:grid-cols-2">
              {dataOptions.map((option) => (
                <div>
                  <input
                    type="radio"
                    id={option.id}
                    name="data_infrastructure"
                    value={option.value}
                    class="sr-only icp-choice"
                  />
                  <label
                    for={option.id}
                    class="icp-option-card block cursor-pointer border border-white/10 bg-white/[0.02] p-5 transition-all"
                  >
                    <span class="block text-white font-display font-black text-base md:text-lg uppercase tracking-tight">{option.label}</span>
                    <span class="block mt-2 text-white/55 font-body text-sm leading-relaxed">{option.hint}</span>
                  </label>
                </div>
              ))}
            </div>
          </fieldset>

          <fieldset class="icp-panel icp-panel--investment border border-white/8 p-6 md:p-8 flex flex-col gap-5">
            <legend class="text-white/70 font-mono text-[11px] uppercase tracking-widest px-2">{t('contact.qualify.investment_label')}</legend>
            <p class="text-white/55 font-body text-sm md:text-base leading-relaxed height-min-90px">
              {t('contact.qualify.investment_caption')}
            </p>
            <div class="grid gap-3 sm:grid-cols-2">
              {investmentOptions.map((option) => (
                <div>
                  <input
                    type="radio"
                    id={option.id}
                    name="growth_investment"
                    value={option.value}
                    class="sr-only icp-choice"
                  />
                  <label
                    for={option.id}
                    class="icp-option-card block cursor-pointer border border-white/10 bg-white/[0.02] p-5 transition-all"
                  >
                    <span class="block text-white font-display font-black text-base md:text-lg uppercase tracking-tight">{option.label}</span>
                    <span class="block mt-2 text-white/55 font-body text-sm leading-relaxed">{option.hint}</span>
                  </label>
                </div>
              ))}
            </div>
          </fieldset>
        </div>
      </div>

      <div class="lg:sticky lg:top-28">
        <div
          id="icp-audit-panel"
          data-state="incomplete"
          class="border border-white/10 bg-black/60 p-6 md:p-8 flex flex-col gap-8"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="text-corporate-green font-mono text-[10px] uppercase">{t('contact.qualify.audit_label')}</span>
            <span id="icp-audit-badge" class="text-white/60 font-mono text-[9px] uppercase tracking-[0.3em] text-right">{t('contact.qualify.state.incomplete.title')}</span>
          </div>

          <div class="flex flex-col gap-3" aria-live="polite">
            <h3 id="icp-audit-title" class="text-white font-display font-black text-3xl uppercase tracking-tight">
              {t('contact.qualify.state.incomplete.title')}
            </h3>
            <p id="icp-audit-body" class="text-white/55 font-body text-sm md:text-base leading-relaxed">
              {t('contact.qualify.state.incomplete.body')}
            </p>
          </div>

          <div class="icp-console border-y border-white/8 py-3">
            <div id="icp-audit-manual-row" class="icp-console-row" data-ready="false">
              <span id="icp-audit-manual-flag" class="icp-console-flag" aria-hidden="true">[!]</span>
              <div class="min-w-0 flex flex-1 flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                <span class="icp-console-label">{t('contact.qualify.manual_label')}</span>
                <span id="icp-audit-manual" class="icp-console-value">{t('contact.qualify.unset')}</span>
              </div>
            </div>

            <div id="icp-audit-data-row" class="icp-console-row" data-ready="false">
              <span id="icp-audit-data-flag" class="icp-console-flag" aria-hidden="true">[!]</span>
              <div class="min-w-0 flex flex-1 flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                <span class="icp-console-label">{t('contact.qualify.data_label')}</span>
                <span id="icp-audit-data" class="icp-console-value">{t('contact.qualify.unset')}</span>
              </div>
            </div>

            <div id="icp-audit-investment-row" class="icp-console-row" data-ready="false">
              <span id="icp-audit-investment-flag" class="icp-console-flag" aria-hidden="true">[!]</span>
              <div class="min-w-0 flex flex-1 flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                <span class="icp-console-label">{t('contact.qualify.investment_label')}</span>
                <span id="icp-audit-investment" class="icp-console-value">{t('contact.qualify.unset')}</span>
              </div>
            </div>
          </div>

          <div class="icp-audit-footer pt-6 flex flex-col gap-6">
            <div class="flex items-end justify-between gap-6">
              <div class="flex flex-col gap-2 height-min-65px">
                <span class="text-white/50 font-mono text-[9px] uppercase tracking-[0.35em]">{t('contact.qualify.score_label')}</span>
                <p id="icp-audit-score" class="text-corporate-green font-display font-black text-3xl uppercase tracking-tight">--/100</p>
              </div>
              <div class="text-right flex flex-col gap-2 height-min-65px">
                <span class="text-white/45 font-mono text-[9px] uppercase tracking-[0.35em]">{t('contact.qualify.audit_label')}</span>
                <p id="icp-audit-footer-state" class="text-white/72 font-body text-sm leading-relaxed">{t('contact.qualify.state.incomplete.title')}</p>
              </div>
            </div>

            <button
              id="icp-evaluate"
              type="button"
              disabled
              data-state="incomplete"
              class="w-full px-8 py-5 font-display font-black uppercase tracking-[0.18em] transition-all"
            >
              {t('contact.qualify.button.incomplete')}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Branch 1: Disqualified -->
  <div id="icp-disqualified" class="hidden flex flex-col gap-10 animate-fade-in">
    <div class="flex flex-col gap-6 text-center max-w-2xl mx-auto">
      <div class="w-20 h-20 border-2 border-brand mx-auto flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#e8003d" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
      </div>
      <h2 id="icp-disqualified-title" class="text-white font-display font-black text-3xl uppercase tracking-tighter">{t('contact.disqualified.title')}</h2>
      <p id="icp-disqualified-body" class="text-white/60 font-body text-xl leading-relaxed italic">
        {t('contact.disqualified.msg')}
      </p>
      <p class="text-white/45 font-body text-base md:text-lg leading-relaxed">
        {t('contact.disqualified.open_channel')}
      </p>
    </div>
    <OpenChannelForm />
  </div>

  <!-- Branch 2: Qualified -->
  <div id="icp-qualified" class="hidden animate-fade-in">
    <div class="mb-10 text-center">
      <h2 class="text-white font-display font-black text-3xl uppercase tracking-tighter mb-4">{t('contact.qualified.title')}</h2>
    </div>
    <QualifiedForm />
  </div>

  <!-- Branch 3: Borderline -->
  <div id="icp-borderline" class="hidden animate-fade-in">
    <div class="mb-10 text-center">
      <h2 class="text-white font-display font-black text-3xl uppercase tracking-tighter mb-4">{t('contact.borderline.title')}</h2>
    </div>
    <BorderlineForm />
  </div>

  <!-- Industrial Detail -->
  <div class="icp-watermark absolute bottom-4 right-4 opacity-10 font-mono text-[8px] uppercase tracking-widest" aria-hidden="true">ICP_ENGINE_JTBD_v1</div>
</div>

<script>
  const container = document.getElementById('icp-container');
  const searchParams = new URLSearchParams(window.location.search);
  const inquiryTypeOverride =
    container?.dataset.inquiryTypeOverride?.trim() ||
    (searchParams.get('type') === 'roi-audit' ? 'ROI_AUDIT_LEAD' : '');
  const entryPoint =
    container?.dataset.entryPoint?.trim() ||
    searchParams.get('entry_point') ||
    (searchParams.get('type') === 'roi-audit' ? 'roi_audit' : '');
  const serviceInterest =
    container?.dataset.serviceInterest?.trim() ||
    searchParams.get('service_interest') ||
    (searchParams.get('type') === 'roi-audit' ? 'roi_audit' : '');
  const isRoiAuditFlow =
    inquiryTypeOverride === 'ROI_AUDIT_LEAD' ||
    entryPoint === 'roi_audit' ||
    serviceInterest === 'roi_audit';
  const step1 = document.getElementById('icp-step-1');
  const evalBtn = document.getElementById('icp-evaluate');
  const auditPanel = document.getElementById('icp-audit-panel');
  const auditBadge = document.getElementById('icp-audit-badge');
  const auditTitle = document.getElementById('icp-audit-title');
  const auditBody = document.getElementById('icp-audit-body');
  const auditManual = document.getElementById('icp-audit-manual');
  const auditData = document.getElementById('icp-audit-data');
  const auditInvestment = document.getElementById('icp-audit-investment');
  const auditManualRow = document.getElementById('icp-audit-manual-row');
  const auditDataRow = document.getElementById('icp-audit-data-row');
  const auditInvestmentRow = document.getElementById('icp-audit-investment-row');
  const auditManualFlag = document.getElementById('icp-audit-manual-flag');
  const auditDataFlag = document.getElementById('icp-audit-data-flag');
  const auditInvestmentFlag = document.getElementById('icp-audit-investment-flag');
  const auditScore = document.getElementById('icp-audit-score');
  const auditFooterState = document.getElementById('icp-audit-footer-state');
  const disqualifiedTitle = document.getElementById('icp-disqualified-title');
  const disqualifiedBody = document.getElementById('icp-disqualified-body');
  const manualInput = document.getElementById('icp-manual') as HTMLInputElement | null;
  const manualVal = document.getElementById('manual-val');
  const copyEl = document.getElementById('icp-copy');
  const copy = copyEl
    ? JSON.parse(decodeURIComponent(copyEl.getAttribute('data-json') || '%7B%7D'))
    : {};
  const track = (eventName: string, payload: Record<string, unknown> = {}) => {
    window.dispatchEvent(new CustomEvent('aglaya:track', {
      detail: { event: eventName, payload },
    }));
  };

  const dataInputs = Array.from(document.querySelectorAll('input[name="data_infrastructure"]')) as HTMLInputElement[];
  const investmentInputs = Array.from(document.querySelectorAll('input[name="growth_investment"]')) as HTMLInputElement[];

  const touched = {
    manual: false,
    data: false,
    investment: false,
  };

  const infrastructureScores: Record<string, number> = {
    none: 0,
    spreadsheet: 35,
    crm: 70,
    lake: 100,
  };

  const investmentScores: Record<string, number> = {
    under_5: 0,
    between_5_15: 45,
    between_15_40: 75,
    over_40: 100,
  };

  function getSelectedValue(inputs: HTMLInputElement[]) {
    return inputs.find((input) => input.checked)?.value;
  }

  function getManualBand(manual: number) {
    if (manual < 35) return 'low';
    if (manual < 65) return 'mid';
    return 'high';
  }

  function getQualificationState() {
    const manual = manualInput ? parseInt(manualInput.value, 10) : 0;
    const data = getSelectedValue(dataInputs);
    const investment = getSelectedValue(investmentInputs);
    const complete = touched.manual && touched.data && touched.investment;

    const manualBand = getManualBand(manual);
    const infrastructureScore = data ? infrastructureScores[data] : 0;
    const investmentScore = investment ? investmentScores[investment] : 0;
    const score = Math.round(manual * 0.4 + infrastructureScore * 0.25 + investmentScore * 0.35);

    let state = 'incomplete';

    if (!complete) {
      state = 'incomplete';
    } else if (investment === 'under_5') {
      state = 'blocked_investment';
    } else if (data === 'none') {
      state = 'blocked_data';
    } else if (manual < 35) {
      state = 'blocked_manual';
    } else if (
      score >= 72 &&
      manual >= 60 &&
      (data === 'crm' || data === 'lake') &&
      (investment === 'between_15_40' || investment === 'over_40')
    ) {
      state = 'qualified';
    } else {
      state = 'borderline';
    }

    return {
      complete,
      manual,
      manualBand,
      data,
      investment,
      score,
      state,
    };
  }

  function updateAuditInterface() {
    const result = getQualificationState();
    const stateCopy = copy.states?.[result.state] ?? copy.states?.incomplete;

    if (manualVal) {
      manualVal.textContent = touched.manual ? `${result.manual}%` : copy.unset;
    }

    if (manualInput) {
      manualInput.style.setProperty('--range-progress', `${result.manual}%`);
    }

    if (auditScore) {
      auditScore.textContent = result.complete ? `${result.score}/100` : '--/100';
    }

    if (auditManual) {
      auditManual.textContent = touched.manual
        ? copy.audit?.manual?.[result.manualBand] ?? copy.unset
        : copy.unset;
    }

    if (auditData) {
      auditData.textContent = result.data
        ? copy.audit?.data?.[result.data] ?? copy.unset
        : copy.unset;
    }

    if (auditInvestment) {
      auditInvestment.textContent = result.investment
        ? copy.audit?.investment?.[result.investment] ?? copy.unset
        : copy.unset;
    }

    if (auditBadge) auditBadge.textContent = stateCopy?.title ?? '';
    if (auditTitle) auditTitle.textContent = stateCopy?.title ?? '';
    if (auditBody) auditBody.textContent = stateCopy?.body ?? '';
    if (auditFooterState) auditFooterState.textContent = stateCopy?.title ?? '';

    const manualReady = touched.manual;
    const dataReady = Boolean(result.data);
    const investmentReady = Boolean(result.investment);

    if (auditManualRow) auditManualRow.dataset.ready = manualReady ? 'true' : 'false';
    if (auditDataRow) auditDataRow.dataset.ready = dataReady ? 'true' : 'false';
    if (auditInvestmentRow) auditInvestmentRow.dataset.ready = investmentReady ? 'true' : 'false';
    if (auditManualFlag) auditManualFlag.textContent = manualReady ? '[OK]' : '[!]';
    if (auditDataFlag) auditDataFlag.textContent = dataReady ? '[OK]' : '[!]';
    if (auditInvestmentFlag) auditInvestmentFlag.textContent = investmentReady ? '[OK]' : '[!]';

    if (evalBtn) {
      evalBtn.textContent = stateCopy?.button ?? '';
      evalBtn.dataset.state = result.state;
      (evalBtn as HTMLButtonElement).disabled = result.state === 'incomplete';
    }

    if (auditPanel) auditPanel.dataset.state = result.state;
    if (container) container.dataset.state = result.state;

    return result;
  }

  function markManualTouched() {
    touched.manual = true;
    updateAuditInterface();
  }

  manualInput?.addEventListener('input', markManualTouched);
  manualInput?.addEventListener('change', markManualTouched);

  dataInputs.forEach((input) => {
    input.addEventListener('change', () => {
      touched.data = true;
      updateAuditInterface();
    });
  });

  investmentInputs.forEach((input) => {
    input.addEventListener('change', () => {
      touched.investment = true;
      updateAuditInterface();
    });
  });

  updateAuditInterface();

  evalBtn?.addEventListener('click', () => {
    const result = updateAuditInterface();

    if (result.state === 'incomplete') return;

    track('icp_evaluated', {
      icp_state: result.state,
      icp_score: result.score,
      manual_execution: result.manual,
      data_infrastructure: result.data ?? 'unset',
      growth_investment: result.investment ?? 'unset',
    });

    step1?.classList.add('opacity-0');

    setTimeout(() => {
      step1?.classList.add('hidden');

      let branchId = 'icp-borderline';
      const stateCopy = copy.states?.[result.state] ?? copy.states?.incomplete;

      if (result.state === 'qualified') {
        branchId = 'icp-qualified';
      } else if (result.state.startsWith('blocked')) {
        branchId = 'icp-disqualified';
        if (disqualifiedTitle) disqualifiedTitle.textContent = stateCopy?.title ?? '';
        if (disqualifiedBody) disqualifiedBody.textContent = stateCopy?.body ?? '';
      }

      const branchEl = document.getElementById(branchId);
      branchEl?.classList.remove('hidden');

      track('icp_branch_viewed', {
        icp_state: result.state,
        icp_branch: branchId.replace('icp-', ''),
        icp_score: result.score,
        manual_execution: result.manual,
        data_infrastructure: result.data ?? 'unset',
        growth_investment: result.investment ?? 'unset',
      });

      const forms = branchEl?.querySelectorAll('form');
      forms?.forEach((formEl) => {
        const signalValues: Record<string, string> = {
          manual_execution: result.manual.toString(),
          data_infrastructure: result.data ?? '',
          growth_investment: result.investment ?? '',
          icp_signal_score: result.score.toString(),
          icp_primary_state: result.state,
        };

        Object.entries(signalValues).forEach(([name, value]) => {
          const input = formEl.querySelector(`[name="${name}"]`) as HTMLInputElement | null;
          if (input) input.value = value;
        });

        const statusInput = formEl.querySelector('[name="icp_status"]') as HTMLInputElement | null;
        if (statusInput) {
          statusInput.value = result.state === 'qualified' ? 'QUALIFIED' : result.state === 'borderline' ? 'BORDERLINE' : result.state.toUpperCase();
        }

        const inquiryTypeInput = formEl.querySelector('[name="inquiry_type"]') as HTMLInputElement | null;
        if (inquiryTypeInput) {
          inquiryTypeInput.value =
            inquiryTypeOverride ||
            (result.state === 'qualified'
              ? 'QUALIFIED_LEAD'
              : result.state === 'borderline'
                ? 'BORDERLINE_LEAD'
                : `${result.state.toUpperCase()}_LEAD`);
        }

        const entryPointInput = formEl.querySelector('[name="entry_point"]') as HTMLInputElement | null;
        if (entryPointInput) {
          entryPointInput.value = entryPoint;
        }

        const serviceInterestInput = formEl.querySelector('[name="service_interest"]') as HTMLInputElement | null;
        if (serviceInterestInput) {
          serviceInterestInput.value = serviceInterest;
        }

        const messageInput = formEl.querySelector('[name="message"]') as HTMLTextAreaElement | null;
        if (messageInput && branchId === 'icp-disqualified') {
          messageInput.placeholder = copy.forms?.blockedPlaceholders?.[result.state] ?? messageInput.placeholder;
        }

        if (messageInput && isRoiAuditFlow && branchId !== 'icp-disqualified') {
          messageInput.placeholder = copy.forms?.roiAuditPlaceholder ?? messageInput.placeholder;
        }
      });

      container?.classList.add('border-brand/40');
    }, 400);
  });
</script>

