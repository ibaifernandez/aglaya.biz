---
/**
 * T2 · the problem — reference `docs/design/portada-nueva/t2-selector.html`:
 * the three pairs as a selector on the left, one stage on the right.
 *
 * Ground floor (no JavaScript): the three pairs read in full, each problem struck
 * through, each way out written, next to the drawing of pair 1 at rest in its
 * final frame. That is how the HTML is served.
 *
 * Three floors above it, each its own file so each is only downloaded where it
 * runs:
 *   ./story-selector.ts     the tabs (ARIA, keyboard, which pair is open, the
 *                           still frame on the stage). Always, with JavaScript.
 *   ./story-text-motion.ts  the strike and the typing. Not with reduced motion.
 *   ./story-motion.ts       the drawing going from chaos to order. Only on a
 *                           wide screen (> 860px) and not with reduced motion.
 *
 * Tabs and panels: the tabs live in their own wrapper (the tablist), the three
 * text panels after it, so the tablist owns tabs and nothing else. The wrapper
 * is `display: contents` and the grid puts each panel right under its tab.
 *
 * The drawing is three separate, provisional pieces that will be swapped for
 * video: pair 1's Tetris (./story-tetris.ts), pair 2's heat map
 * (./story-heatmap.ts) and pair 3's plugs (./story-plugs.ts). Their three final
 * frames travel as <template>s, inert and out of the DOM, each with its own
 * name, so changing pair without the motion module costs no script.
 */
import { copyFor, rich, type Lang } from './copy';
import { tetrisFinalMarkup, TETRIS_PAIR } from './story-tetris';
import { heatmapFinalMarkup, HEATMAP_PAIR } from './story-heatmap';
import { plugsFinalMarkup, PLUGS_PAIR } from './story-plugs';

/* Final frame and name of each pair — each last frame drawn as SVG by the same
   code its canvas runs. */
const { lang = 'en' } = Astro.props as { lang?: Lang };
const { problem } = copyFor(lang);
const PIECES: Record<number, { svg: (l: Lang) => string; label: string }> = {
  [TETRIS_PAIR]: { svg: tetrisFinalMarkup, label: problem.tetrisLabel },
  [HEATMAP_PAIR]: { svg: heatmapFinalMarkup, label: problem.heatmapLabel },
  [PLUGS_PAIR]: { svg: plugsFinalMarkup, label: problem.plugsLabel },
};
const frames = problem.pairs.map((_, i) => ({ svg: PIECES[i].svg(lang), label: PIECES[i].label }));
---

<section class="pv-section pv-story" id="problem" data-tramo="T2" data-pv-story>
  <div class="pv-wrap pv-story-in">
    <div class="pv-eyebrow pv-mono">{problem.eyebrow}</div>
    <h2 class="pv-sec-h">{problem.title} <em>{problem.titleEm}</em></h2>
    <div class="pv-board">
      <div class="pv-list">
        <div class="pv-tabs" data-pv-tabs data-pv-label={problem.tabsLabel}>
          {problem.pairs.map((pair, i) => (
            <h3 class="pv-tab" id={`pv-tab-${i}`} data-pv-tab style={`--row: ${i * 2 + 1}`}>
              <span class="pv-tab-n pv-mono">{pair.n}</span>{' '}
              <span class="pv-prob-h"><span class="pv-strike">{pair.problem}</span></span>
            </h3>
          ))}
        </div>
        {problem.pairs.map((pair, i) => (
          <div class="pv-panel" id={`pv-panel-${i}`} data-pv-panel style={`--row: ${i * 2 + 2}`}>
            <p class="pv-prob-p">{rich(pair.problemText).map((p) => (p.em ? <em>{p.text}</em> : p.strong ? <strong>{p.text}</strong> : p.text))}</p>
            <h3 class="pv-sol-h" aria-label={pair.solution}>
              <span class="pv-done" aria-hidden="true">{pair.solution}</span><span class="pv-caret" aria-hidden="true"></span><span class="pv-rest" aria-hidden="true"></span>
            </h3>
            <p class="pv-sol-p">{pair.solutionText}</p>
          </div>
        ))}
      </div>
      <div class="pv-stage" data-pv-stage>
        <div class="pv-story-canvas" role="img" aria-label={frames[0].label} data-pv-story-drawing set:html={frames[0].svg}></div>
        {frames.map((f) => <template data-pv-frame data-pv-label={f.label} set:html={f.svg}></template>)}
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Ground floor ---------- */
  .pv-story {
    background: var(--color-surface);
  }
  .pv-story-in { padding-block: 60px; }

  .pv-board {
    display: grid;
    /* 1.3 : 1 — the list wider than the mock-up's 1 : 1.05, so pair 1 open wraps
       one line less and T2 fits a 1440 × 900 screen with the stage as tall as the list. */
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    margin-top: 48px;
    align-items: start;
  }

  /* One grid for tabs and panels: tab i on row 2i+1, its panel right under it
     on row 2i+2. The tablist wrapper does not make a box. */
  .pv-list { display: grid; grid-template-columns: minmax(0, 1fr); min-width: 0; }
  .pv-tabs { display: contents; }
  .pv-tab,
  .pv-panel { grid-row: var(--row); grid-column: 1; }

  /* A pair is one card: the tab is its top, the panel its bottom. */
  .pv-tab {
    margin-top: 12px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-bottom: 0;
    border-left: 4px solid transparent;
    padding: 18px 20px 0;
    /* The h3 base (line-height .92, uppercase display) is the mock-up's .prob-h. */
    font-size: clamp(20px, 2vw, 26px);
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .pv-tab[id='pv-tab-0'] { margin-top: 0; }
  .pv-tab-n {
    display: block;
    color: var(--color-brand-dark);
    line-height: 1.6;
    margin-bottom: 6px;
  }
  .pv-prob-h { color: var(--color-faint); }
  /* The strike. `--strike` runs 0 → 1; the ground floor shows it done. Drawn
     as a background on an inline box cloned per line, so a problem that wraps
     is struck line by line. */
  .pv-strike {
    padding-inline: 0.04em;
    margin-inline: -0.04em;
    background: linear-gradient(var(--color-brand), var(--color-brand)) no-repeat 0 55% / calc(100% * var(--strike, 1)) 0.09em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .pv-panel {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-top: 0;
    border-left: 4px solid transparent;
    padding: 2px 20px 18px;
  }
  .pv-prob-p,
  .pv-sol-p {
    margin-top: 10px;
    font-size: 15px;
  }
  .pv-prob-p { color: var(--color-muted); }
  /* The grill's emphasis, both words the same: ink at 500 on the grey paragraph.
     Inter Medium is a face the page loads anyway; an italic and a 700 were 131 KB
     each on the way to the largest paint (card 82868b81, option B). No slant at
     all, so never a fake one. */
  .pv-prob-p em,
  .pv-prob-p strong { font-style: normal; font-weight: 500; color: var(--color-text); }
  .pv-sol-p { color: var(--color-text); }
  .pv-sol-h {
    margin-top: 16px;
    font-size: clamp(22px, 2.2vw, 30px);
    color: var(--color-brand-dark);
  }
  .pv-rest { color: color-mix(in srgb, var(--color-text) 6%, transparent); }
  .pv-caret {
    display: none;
    width: 0.09em;
    height: 0.82em;
    background: var(--color-brand);
    vertical-align: -0.06em;
    margin-inline: 0.02em;
    animation: pv-blink 1s steps(2) infinite;
  }
  @keyframes pv-blink { 50% { opacity: 0.15; } }

  /* Side by side, the stage's box is as tall as the list (stretched over the
     grid row, which the list sets), and follows it when another pair opens. */
  .pv-stage {
    position: sticky;
    top: 84px; /* under the 60px fixed header, with the mock-up's 24px of air */
    min-width: 0;
    align-self: stretch;
  }
  .pv-story-canvas {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    container-type: size;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }
  /* The drawing is 4:5 (the 400 × 500 board of ./story-tetris.ts,
     ./story-heatmap.ts and ./story-plugs.ts), scaled to fit the box whole and
     centred: never stretched, never cropped; what is left over at the sides is
     the stage's own paper. */
  .pv-story-canvas :global(svg),
  .pv-story-canvas :global(canvas) {
    display: block;
    width: min(100cqw, 80cqh);
    height: min(100cqh, 125cqw);
  }

  /* One column: the stage goes ON TOP of the list (the card asks for it; the
     mock-up left it below) and stops being sticky. */
  @media (max-width: 860px) {
    .pv-board { grid-template-columns: minmax(0, 1fr); }
    .pv-stage {
      order: -1;
      position: relative;
      top: 0;
      max-width: 440px;
      width: 100%;
      justify-self: center;
    }
    /* On top of the list, the box itself is 4:5: the drawing fills it. */
    .pv-story-canvas { height: auto; aspect-ratio: 4 / 5; }
  }

  /* ---------- Selector (./story-selector.ts adds `is-sel`) ---------- */
  .pv-story.is-sel .pv-tab { cursor: pointer; }
  .pv-story.is-sel .pv-tab:hover { border-color: var(--color-border-strong); }
  .pv-story.is-sel .pv-tab[aria-selected='true'] {
    border-color: var(--color-text);
    border-left-color: var(--color-brand);
    box-shadow: 0 24px 50px -30px color-mix(in srgb, var(--color-text) 35%, transparent);
  }
  .pv-story.is-sel .pv-panel.is-on {
    border-color: var(--color-text);
    border-left-color: var(--color-brand);
  }
  .pv-story.is-sel .pv-tab:focus-visible,
  .pv-story.is-sel .pv-panel:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 0;
  }
  /* Motion allowed: only the chosen pair is open. A closed tab is a whole card. */
  .pv-story.is-sel:not(.is-calm) .pv-panel:not(.is-on) { display: none; }
  .pv-story.is-sel:not(.is-calm) .pv-tab:not([aria-selected='true']) {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 18px;
  }

  /* ---------- Text motion (./story-text-motion.ts adds `is-fx`) ---------- */
  .pv-story.is-fx .pv-prob-h { color: var(--color-text); }
  .pv-story.is-fx .pv-prob-h.is-struck { color: var(--color-faint); }
  .pv-story.is-fx .pv-sol-h.is-typing .pv-caret { display: inline-block; }
  .pv-story.is-fx .pv-sol-p { opacity: 0; transition: opacity 0.5s; }
  .pv-story.is-fx .pv-sol-p.is-on { opacity: 1; }
</style>
