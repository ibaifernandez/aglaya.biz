---
/**
 * HIDDEN PREVIEW of the new home page, in one language: `/preview/home/` (EN)
 * and `/es/preview/home/` (ES) are this same page. Neither is linked from the
 * site — only from each other, through «EN / ES» in the header. Both are
 * `noindex`, out of the sitemap (filter in astro.config.mjs), and announce no
 * hreflang (`isUnpaired` in src/i18n/routes.ts): a noindex page has no twin to
 * declare. The current home page is untouched.
 *
 * Reference: docs/design/portada-nueva/portada-aglaya.html. Built tramo by
 * tramo; T1, T2 and T3 are filled. Everything it uses lives in this folder —
 * dropping the preview means deleting it and the two route files.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PreviewHeader from './PreviewHeader.astro';
import Hook from './Hook.astro';
import Problem from './Problem.astro';
import Built from './Built.astro';
import PreviewFooter from './PreviewFooter.astro';
import { copyFor, type Lang } from './copy';
import './preview-home.css';
// The face of T1's paragraph — the page's largest paint. Same file the package's
// @font-face points at (one hashed asset), asked for first so the faces further
// down the page do not hold it up.
import lcpFont from '@aglaya/design-tokens/fonts/Inter-Regular.otf?url';

const { lang } = Astro.props as { lang: Lang };
const { meta } = copyFor(lang);
---

<BaseLayout title={meta.title} description={meta.description} lang={lang} theme="light" noindex>
  <div class="pv">
    <link rel="preload" href={lcpFont} as="font" type="font/otf" crossorigin />
    <PreviewHeader lang={lang} />
    <main id="main-content">
      <!-- T1 · the hook -->
      <Hook lang={lang} />
      <!-- T2 · the problem -->
      <Problem lang={lang} />
      <!-- T3 · what we've built -->
      <Built lang={lang} />
      <!-- T4 · the Orchestrator -->
      <section class="pv-section" id="orchestrator" data-tramo="T4"></section>
      <!-- T5 · how we work -->
      <section class="pv-section" id="work" data-tramo="T5"></section>
      <!-- T6 · let's talk -->
      <section class="pv-section" id="contact" data-tramo="T6"></section>
    </main>
    <PreviewFooter lang={lang} />
  </div>
</BaseLayout>

<script>
  import './effects';
  import './story-selector';
</script>
