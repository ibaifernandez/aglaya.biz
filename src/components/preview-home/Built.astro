---
/**
 * T3 · what we've built — reference `docs/design/portada-nueva/t3-grid.html`.
 *
 * Ground floor: plain HTML and CSS, every card complete and readable with
 * JavaScript off, and still with reduced motion. One wide card and three pairs
 * of short ones; the three rows of pairs are the same height.
 *
 * The motion is ./effects.ts: each pair of cards moves with the scroll at its
 * row's speed (`data-pv-row`) and «CAPABILITIES» slides across the back. No 3D:
 * the sketch's tilt and depth went on 2026-10-07 (card e726ee8c, Ibai: «ni luce
 * ni informa»). All of it animates FROM states it sets itself; if it never
 * runs, nothing here is left out of place.
 *
 * Each card is a column: drawing, label, title and paragraph from the top,
 * «See how it works» held to the bottom, so the two links of a pair sit on one
 * line whatever the length of their paragraphs or the language.
 *
 * Colours are the canon's tokens; where the sketch spelled a hex, this file
 * names the token that carries it.
 */
import { copyFor, type Lang, type Mini } from './copy';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const { built } = copyFor(lang);

const cards = [
  { row: 0, wide: true, ...built.wide, ours: null as string | null },
  ...built.rows.flatMap((pair, r) => pair.map((c) => ({ row: r + 1, wide: false, ...c }))),
] as { row: number; wide: boolean; title: string; text: string; ours: string | null; mini: Mini }[];
---

<section class="pv-section pv-built" id="built" data-tramo="T3">
  <div class="pv-depth-word" aria-hidden="true">{built.depthWord} · {built.depthWord}</div>
  <div class="pv-wrap">
    <div class="pv-eyebrow pv-mono">{built.eyebrow}</div>
    <h2 class="pv-sec-h">{built.title} <em>{built.titleEm}</em></h2>
    <p class="pv-built-lede">{built.lede}</p>
    <div class="pv-cards" data-pv-cards>
      {cards.map((c) => (
        <article class:list={['pv-card', { 'pv-card--wide': c.wide }]} data-pv-row={c.row}>
          <div class="pv-card-in">
            <div class:list={['pv-mini', `pv-mini--${c.mini.kind}`]} aria-hidden="true">
              {c.mini.kind === 'fleet' && Array.from({ length: 9 }, (_, i) => <span class:list={{ 'is-r': i === 4 }}></span>)}
              {c.mini.kind === 'flow' && c.mini.steps.map((s, i) => (
                <Fragment>{i > 0 && <b></b>}<span class:list={{ 'is-r': s.red }}>{s.text}</span></Fragment>
              ))}
              {c.mini.kind === 'rows' && c.mini.rows.map((r) => (
                <span><i class:list={{ 'is-g': r.green }}></i><s></s><b>{r.text}</b></span>
              ))}
              {c.mini.kind === 'cols' && (
                <Fragment>
                  <div><span></span><span class="is-r"></span><span></span></div>
                  <div><span class="is-r"></span><span></span></div>
                  <div><span></span></div>
                </Fragment>
              )}
              {c.mini.kind === 'swatches' && (
                <Fragment><span class="is-ink"></span><span class="is-r"></span><span class="is-g"></span><span class="is-paper"></span></Fragment>
              )}
            </div>
            {c.ours && <div class="pv-ours pv-mono">{built.oursPrefix} · {c.ours}</div>}
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <span class="pv-more">{built.more} <span aria-hidden="true">→</span></span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pv-built {
    overflow: hidden;
    padding-block: 100px 140px;
    background: var(--color-surface);
  }
  .pv-depth-word {
    position: absolute;
    top: 150px;
    left: 0;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(90px, 17vw, 240px);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--color-text) 12%, transparent);
    pointer-events: none;
    user-select: none;
  }
  .pv-built .pv-wrap { position: relative; }
  .pv-built-lede {
    color: var(--color-muted);
    margin-top: 16px;
    font-size: 18px;
  }

  /* One wide card, then three rows of two — the three rows the same height. */
  .pv-cards {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto repeat(3, 1fr);
    gap: 24px;
    margin-top: 56px;
  }
  .pv-card { min-width: 0; }
  .pv-card--wide { grid-column: 1 / -1; }
  .pv-card-in {
    height: 100%;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 22px;
    box-shadow: 0 30px 60px -30px color-mix(in srgb, var(--color-text) 22%, transparent);
    display: flex;
    flex-direction: column;
  }
  .pv-card h3 { font-size: 26px; margin-top: 6px; }
  .pv-card--wide h3 { font-size: 34px; margin-top: 18px; }
  .pv-card p {
    color: var(--color-muted);
    margin-top: 10px;
    font-size: 15px;
  }
  .pv-card--wide p { font-size: 16px; max-width: 60ch; }
  .pv-ours {
    margin-top: 18px;
    color: var(--color-brand-dark);
    font-size: 10px;
    letter-spacing: 0.18em;
  }
  /* The link at the bottom of the card, at least 16px under the paragraph. */
  .pv-card p { margin-bottom: 16px; }
  .pv-more {
    align-self: flex-start;
    margin-top: auto;
    font: 700 11px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand-dark);
    border-bottom: 2px solid var(--color-brand);
    padding-bottom: 4px;
  }

  /* ---------- The little drawings (decorative) ---------- */
  .pv-mini {
    height: 110px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 12px;
    display: flex;
    gap: 8px;
  }
  .pv-mini--fleet {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    align-items: center;
  }
  .pv-mini--fleet span {
    aspect-ratio: 1;
    max-height: 60px;
    background: var(--color-bg);
    border: 1px solid var(--color-text);
  }
  .pv-mini--fleet span.is-r {
    background: var(--color-brand);
    border-color: var(--color-brand);
    transform: scale(1.35);
  }
  .pv-mini--cols > div { flex: 1; display: flex; flex-direction: column; gap: 6px; }
  .pv-mini--cols span { height: 16px; background: var(--color-bg); border: 1px solid var(--color-border); }
  .pv-mini--cols span.is-r { border-left: 3px solid var(--color-brand); }
  /* Rows: dot, bar, label. One grid for all of them, the label column as wide as
     the widest label and right-aligned, so every bar ends at the same x. */
  .pv-mini--rows {
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr) max-content;
    gap: 7px 8px;
    align-content: start;
    align-items: center;
  }
  .pv-mini--rows > span {
    display: contents;
    font: 10px var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 0.06em;
  }
  .pv-mini--rows > span > b { height: 16px; display: flex; align-items: center; justify-content: flex-end; font-weight: 400; }
  .pv-mini--rows i { width: 8px; height: 8px; background: var(--color-brand); flex: none; }
  .pv-mini--rows i.is-g { background: var(--pv-green); }
  .pv-mini--rows s {
    flex: 1;
    height: 6px;
    background: color-mix(in srgb, var(--color-text) 8%, transparent);
    text-decoration: none;
  }
  .pv-mini--flow { align-items: center; justify-content: space-between; }
  .pv-mini--flow span {
    flex: 1;
    min-width: 0;
    height: 38px;
    border: 1px solid var(--color-text);
    display: grid;
    place-items: center;
    font: 10px var(--font-mono);
    letter-spacing: 0.08em;
    background: var(--color-bg);
    text-align: center;
  }
  .pv-mini--flow span.is-r {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: var(--pv-on-brand);
  }
  .pv-mini--flow b { width: 14px; height: 1px; background: var(--color-text); flex: none; }
  .pv-mini--swatches span { flex: 1; }
  .pv-mini--swatches .is-ink { background: var(--color-text); }
  .pv-mini--swatches .is-r { background: var(--color-brand); }
  .pv-mini--swatches .is-g { background: var(--pv-green); }
  .pv-mini--swatches .is-paper { background: var(--color-bg); border: 1px solid var(--color-border); }

  @media (max-width: 760px) {
    .pv-cards {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
    }
  }
</style>
