---
/**
 * T5 · how we work, compact — the sketch `docs/design/portada-nueva/t5-grid.html`
 * (card f0b32a34; it replaces the mock-up's pinned phrase and sideways panels,
 * «innecesariamente masivo»). Nothing holds the scroll, on any screen.
 *
 * The phrase, solid from the start, at the size of the section headings. Then
 * three cards side by side (stacked under 860px), least to most, in AGLAYA's
 * scheme — grey, red, ink — the same height, each with its «Talk to us» held to
 * the bottom. The link goes to #contact and says which way it is (`data-way`),
 * for T6's form to preselect it once it exists.
 *
 * On a real pointer and a wide screen the whole card is the link: the button's
 * own ::after covers it, so there is still one link per card for a screen
 * reader. On a phone only the button is, so a scroll is never taken for a tap.
 * Under the pointer (motion allowed) the card comes forward: 4% larger, 8px up,
 * a deeper shadow.
 */
import { copyFor, type Lang } from './copy';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const { work } = copyFor(lang);
---

<section class="pv-section pv-work" id="work" data-tramo="T5">
  <div class="pv-wrap">
    <div class="pv-eyebrow pv-mono">{work.eyebrow}</div>
    <h2 class="pv-sec-h pv-work-h">{work.phrase}</h2>
    <div class="pv-ways">
      {work.ways.map((way, i) => (
        <article class:list={['pv-way', `pv-way--${i + 1}`]}>
          <div class="pv-mono pv-way-n">{way.n}</div>
          <h3>{way.title}</h3>
          <p>{way.text}</p>
          <ul>{way.items.map((item) => <li>{item}</li>)}</ul>
          <a class="pv-way-cta" href="#contact" data-way={way.id}>{work.cta} <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pv-work {
    background: var(--color-bg);
    padding-block: 100px 110px;
  }
  /* The section headings' size (.pv-sec-h, as T2 and T3), and no max-width. */
  .pv-work-h { max-width: none; }

  .pv-ways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 56px;
  }
  .pv-way {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 26px 24px;
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-brand);
    box-shadow: 0 30px 60px -30px color-mix(in srgb, var(--color-text) 22%, transparent);
  }
  .pv-way-n { color: var(--color-brand-dark); }
  .pv-way h3 {
    font-size: clamp(26px, 2.6vw, 34px);
    margin-top: 10px;
  }
  .pv-way p {
    color: var(--color-muted);
    margin-top: 12px;
    font-size: 16px;
  }
  .pv-way ul {
    margin: 16px 0 22px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    font-size: 15px;
  }
  .pv-way li { padding-left: 20px; position: relative; }
  .pv-way li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 10px;
    height: 2px;
    background: var(--color-brand);
  }
  .pv-way-cta {
    align-self: flex-start;
    margin-top: auto;
    display: inline-block;
    font: 700 11px/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 13px 16px;
    background: var(--color-brand);
    color: var(--pv-on-brand);
  }

  /* AGLAYA's scheme, least to most: grey, red, ink. */
  .pv-way--1 {
    background: var(--color-surface);
    border-top-color: var(--color-text);
  }
  .pv-way--2 {
    background: var(--color-brand);
    color: var(--pv-on-brand);
    border-color: var(--color-brand);
    border-top-color: var(--color-text);
  }
  .pv-way--3 {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
    border-top-color: var(--color-brand);
  }
  .pv-way--2 .pv-way-n,
  .pv-way--3 .pv-way-n,
  .pv-way--2 p,
  .pv-way--3 p { color: inherit; }
  .pv-way--2 li::before { background: currentColor; }
  .pv-way--2 .pv-way-cta {
    background: var(--color-bg);
    color: var(--color-brand-dark);
  }

  @media (max-width: 860px) {
    .pv-ways { grid-template-columns: minmax(0, 1fr); }
  }

  /* A real pointer on a wide screen: the whole card is the link. */
  @media (hover: hover) and (min-width: 861px) {
    .pv-way-cta::after {
      content: '';
      position: absolute;
      inset: 0;
    }
    .pv-way { cursor: pointer; }
  }
  /* …and under it the card comes forward. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pv-way {
      transition:
        transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
        box-shadow 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .pv-way:hover {
      transform: translateY(-8px) scale(1.04);
      box-shadow: 0 46px 80px -30px color-mix(in srgb, var(--color-text) 38%, transparent);
      z-index: 1;
    }
  }
</style>
