---
/**
 * T1 · the hook — mock-up `section.hero`.
 *
 * Ground floor: plain HTML and CSS, complete and readable with JavaScript off.
 * The motion is layered on top by ./effects.ts, which only ever animates FROM a
 * state it sets itself, so if it never runs nothing here is left hidden.
 */
import { hook } from './copy';
---

<section class="pv-section pv-hook" id="top" data-tramo="T1">
  <div class="pv-wrap">
    <div class="pv-eyebrow pv-mono">{hook.eyebrow}</div>
    <h1 class="pv-hook-title" aria-label={hook.title}>
      {hook.lines.map((line) => (
        <span class:list={['pv-hook-line', { 'pv-hook-line--red': line.red }]}><span>{line.text}</span></span>
      ))}
    </h1>
    <div class="pv-hook-rule"></div>
    <p class="pv-hook-sub">{hook.sub}</p>
    <div class="pv-hook-ctas">
      {hook.ctas.map((cta) => (
        <a class:list={['pv-btn', { 'pv-btn--primary': cta.primary }]} href={cta.href} data-pv-magnet><span>{cta.text}</span></a>
      ))}
    </div>
  </div>
</section>

<style>
  .pv-hook {
    padding-block: 130px 100px;
    overflow: hidden;
  }
  .pv-hook-title {
    font-size: clamp(50px, 10.5vw, 150px);
    margin-top: 22px;
    transform-origin: left top;
  }
  .pv-hook-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }
  .pv-hook-line > span { display: block; }
  .pv-hook-line--red { color: var(--pv-brand); }
  .pv-hook-rule {
    height: 4px;
    background: var(--pv-brand);
    width: min(340px, 60%);
    margin-top: 28px;
  }
  .pv-hook-sub {
    font-size: clamp(18px, 1.7vw, 21px);
    line-height: 1.55;
    margin-top: 26px;
  }
  .pv-hook-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }
</style>
