---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import SectionHeader from './SectionHeader.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="anti-client" class="bg-black py-40 relative overflow-hidden group border-y border-white/5">
  
  <!-- Massive Background Text -->
  <div class="absolute inset-0 flex items-center justify-center opacity-[0.02] pointer-events-none select-none">
    <span class="text-[30vw] font-display font-black uppercase tracking-tighter leading-none -rotate-12">NOT_FOR_ALL</span>
  </div>

  <div class="max-w-7xl mx-auto px-6 flex flex-col lg:flex-row gap-20">
    
    <!-- Left: Statement -->
    <div class="flex-1 flex flex-col gap-12" data-animate="fade-up">
      <SectionHeader 
        eyebrow={t('anti.eyebrow')} 
        heading={t('anti.heading')} 
      />
      
      <div class="flex flex-col gap-8 max-w-lg">
        <p class="text-white/60 text-2xl font-body leading-relaxed border-l-2 border-brand/40 pl-8">
          {t('anti.body')}
        </p>
        
        <div class="flex items-center gap-4 text-brand font-mono text-[10px] uppercase tracking-[0.4em] opacity-60">
          <span>OPERATIONAL_INTEGRITY</span>
          <div class="w-12 h-[1px] bg-brand/20"></div>
        </div>
      </div>
    </div>

    <!-- Right: Exclusions -->
    <div class="flex-1 flex flex-col gap-4">
      {[1, 2, 3].map((num) => (
        <div 
          class="bg-[#050505] border border-white/5 p-10 flex items-center justify-between gap-10 hover:border-brand/40 transition-all cursor-default group/item"
          data-animate="fade-up"
        >
          <div class="flex flex-col gap-2">
            <span class="text-brand font-mono text-[8px] uppercase tracking-[0.5em] opacity-40">EXCLUSION_{num}</span>
            <span class="text-white font-display font-black text-2xl md:text-3xl tracking-tight uppercase group-hover/item:text-brand transition-colors">
              {t(`anti.list.${num}`)}
            </span>
          </div>
          
          <div class="w-12 h-12 flex items-center justify-center shrink-0 border border-white/10 group-hover/item:border-brand transition-colors">
             <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#e8003d" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </div>
        </div>
      ))}

      <!-- Integrity Tag -->
      <div class="mt-8 flex justify-end" data-animate="fade-up">
         <div class="flex items-center gap-3 font-mono text-[10px] text-white/20 uppercase tracking-[0.3em]">
            <span>INTEGRITY_CHECK: PASSED</span>
            <div class="w-2 h-2 bg-brand/40 rounded-full animate-pulse"></div>
         </div>
      </div>
    </div>
  </div>
</section>
