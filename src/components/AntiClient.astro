---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import SectionHeader from './SectionHeader.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const exclusionPrinciples = [1, 2, 3, 4, 5] as const;
const leftExclusionPrinciples = exclusionPrinciples.slice(0, 2);
const rightExclusionPrinciples = exclusionPrinciples.slice(2);
---

<section id="anti-client" class="bg-black py-24 relative overflow-hidden group border-y border-white/5">
  
  <!-- Massive Background Text -->
  <div class="deco-text absolute inset-0 flex items-center justify-center opacity-[0.02] pointer-events-none select-none" aria-hidden="true">
    <span class="text-[30vw] font-display font-black uppercase tracking-tighter leading-none -rotate-12">NOT_FOR_ALL</span>
  </div>

  <div class="max-w-7xl mx-auto px-6 flex flex-col lg:flex-row gap-20">
    
    <!-- Left: Statement -->
    <div class="flex-1 flex flex-col gap-6 lg:gap-4">
      <div class="flex flex-col" data-animate="fade-up">
        <SectionHeader 
          eyebrow={t('anti.eyebrow')} 
          heading={t('anti.heading')}
          spacing="mb-4"
        />
        
        <div class="flex flex-col gap-8 max-w-lg">
          <p class="text-white/60 font-body leading-relaxed border-l-2 border-brand/40 pl-8">
            {t('anti.body')}
          </p>
          
          <div class="flex items-center gap-4 text-corporate-green font-mono text-[10px] uppercase tracking-[0.4em] opacity-60">
            <span class="inline-block mb-8">OPERATIONAL_INTEGRITY</span>
            <div class="w-12 h-[1px] bg-brand/20"></div>
          </div>
        </div>
      </div>

      {leftExclusionPrinciples.map((num) => (
        <div 
          class="bg-[#050505] border border-white/5 p-8 md:p-10 flex items-start justify-between gap-6 md:gap-10 hover:border-brand/40 transition-all cursor-default group/item"
          data-animate="fade-up"
        >
          <div class="flex flex-col gap-4 max-w-3xl">
            <div class="flex flex-col gap-2">
              <span class="text-corporate-green font-mono text-[8px] uppercase tracking-[0.5em] opacity-40">
                {`EXCLUSION_PRINCIPLE_${String(num).padStart(2, '0')}`}
              </span>
              <span class="text-white font-display font-black text-2xl md:text-3xl tracking-tight uppercase group-hover/item:text-brand transition-colors">
                {t(`anti.list.${num}.title`)}
              </span>
            </div>

            <p class="max-w-2xl text-white/55 font-body text-base md:text-lg leading-relaxed">
              {t(`anti.list.${num}.body`)}
            </p>
          </div>
          
          <div class="w-12 h-12 flex items-center justify-center shrink-0 border border-white/10 group-hover/item:border-brand transition-colors mt-1">
             <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#e8003d" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </div>
        </div>
      ))}
    </div>

    <!-- Right: Exclusions -->
    <div class="flex-1 flex flex-col gap-6 lg:gap-8">
      {rightExclusionPrinciples.map((num) => (
        <div 
          class="bg-[#050505] border border-white/5 p-8 md:p-10 flex items-start justify-between gap-6 md:gap-10 hover:border-brand/40 transition-all cursor-default group/item"
          data-animate="fade-up"
        >
          <div class="flex flex-col gap-4 max-w-3xl">
            <div class="flex flex-col gap-2">
              <span class="text-corporate-green font-mono text-[8px] uppercase tracking-[0.5em] opacity-40">
                {`EXCLUSION_PRINCIPLE_${String(num).padStart(2, '0')}`}
              </span>
              <span class="text-white font-display font-black text-2xl md:text-3xl tracking-tight uppercase group-hover/item:text-brand transition-colors">
                {t(`anti.list.${num}.title`)}
              </span>
            </div>

            <p class="max-w-2xl text-white/55 font-body text-base md:text-lg leading-relaxed">
              {t(`anti.list.${num}.body`)}
            </p>
          </div>
          
          <div class="w-12 h-12 flex items-center justify-center shrink-0 border border-white/10 group-hover/item:border-brand transition-colors mt-1">
             <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#e8003d" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </div>
        </div>
      ))}

      <!-- Integrity Tag -->
      <div class="mt-8 flex justify-end" data-animate="fade-up">
         <div class="flex items-center gap-3 font-mono text-[10px] text-white/20 uppercase tracking-[0.3em]">
            <span class="codetag-25">INTEGRITY_CHECK: PASSED</span>
            <div class="w-2 h-2 bg-brand/40 rounded-full animate-pulse"></div>
            <div class="w-2 h-2 bg-brand/40 rounded-full animate-pulse"></div>
            <div class="w-2 h-2 bg-brand/40 rounded-full animate-pulse"></div>
            <div class="w-2 h-2 bg-brand/40 rounded-full animate-pulse"></div>
         </div>
      </div>
    </div>
  </div>
</section>
