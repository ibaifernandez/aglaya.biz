---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section 
  id="hero" 
  class="relative min-h-screen flex flex-col justify-center px-6 sm:px-10 lg:px-20 overflow-hidden bg-black"
>
  <!-- Background Aura -->
  <div class="absolute top-1/2 left-1/4 w-[500px] h-[500px] bg-brand/5 blur-[120px] rounded-full -translate-y-1/2 pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto w-full pt-20 flex flex-col gap-10">
    
    <!-- Eyebrow -->
    <div class="flex items-center gap-4 overflow-hidden" data-animate="fade-up">
      <div class="w-8 h-[1px] bg-brand"></div>
      <span class="text-corporate-green font-mono text-[10px] sm:text-xs font-black tracking-[0.5em] uppercase">
        {t('hero.eyebrow')}
      </span>
    </div>

    <!-- Main Heading -->
    <h1 
      class="text-white font-display font-black text-5xl sm:text-7xl lg:text-9xl tracking-tighter leading-[0.9] uppercase"
      data-animate="fade-up"
    >
      {t('hero.heading').split('\n').map((line, i) => (
        <span class="block overflow-hidden">
          <span class={`block ${i === 1 ? 'text-brand' : ''}`}>{line}</span>
        </span>
      ))}
    </h1>

    <!-- Subtext -->
    <div class="max-w-xl flex flex-col gap-12" data-animate="fade-up">
      <p class="text-muted font-body text-xl sm:text-2xl leading-relaxed">
        {t('hero.subtext')}
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center gap-8">
        <a 
          href={translatePath('/contact/')}
          class="group relative bg-brand hover:bg-brand-dark text-white px-5 py-5 font-display text-lg font-black uppercase tracking-widest transition-all hover:scale-[1.02]"
        >
          {t('hero.cta')}
          <span class="absolute inset-0 border border-white/20 translate-x-1 translate-y-1 -z-10 group-hover:translate-x-0 group-hover:translate-y-0 transition-transform"></span>
        </a>
        
        <a 
          href={translatePath('/proof/')}
          class="text-muted hover:text-white font-mono text-xs uppercase tracking-[0.3em] flex items-center gap-4 transition-colors group"
        >
          {t('hero.secondary')}
          <span class="w-10 h-[1px] bg-white/20 group-hover:w-16 group-hover:bg-brand transition-all"></span>
        </a>
      </div>
    </div>
  </div>

</section>

<style>
  #hero {
    /* Industrial Scanline Overlay */
    background-image: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), 
                      linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
    background-size: 100% 4px, 3px 100%;
  }
</style>