---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const cases = [
  { id: 'pocuro', client: 'POCURO', industry: 'Real Estate' },
  { id: 'norden', client: 'NORDEN', industry: 'Industrial' }
];
---

<section id="proof" class="bg-black py-32 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 flex flex-col gap-24 relative z-10">
    
    <!-- Heading -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-10">
      <div class="flex flex-col gap-4">
        <span class="text-brand font-mono text-[10px] font-black tracking-[0.4em] uppercase">
          {t('proof.eyebrow')}
        </span>
        <h2 class="text-white font-display font-black text-4xl md:text-6xl tracking-tighter leading-none">
          {t('proof.heading')}
        </h2>
      </div>
      
      <a 
        href={translatePath('/proof')} 
        class="group flex items-center gap-4 border border-white/10 hover:border-brand/40 px-8 py-4 transition-all"
      >
        <span class="text-white font-display text-[10px] font-black uppercase tracking-[0.3em]">{t('proof.view_all')}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-brand group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Proof Cards Container (Flexbox) -->
    <div class="flex flex-col lg:flex-row gap-1 border-y border-white/5 bg-white/5">
      {cases.map((c) => (
        <a 
          href={translatePath(`/proof/${c.id}`)}
          class="flex-1 bg-black p-12 hover:bg-white/5 transition-all group flex flex-col gap-12 border border-white/5 lg:border-none"
        >
          <!-- Industrial Header -->
          <div class="flex justify-between items-start">
             <div class="flex flex-col gap-1">
               <span class="text-brand font-mono text-[10px] font-bold tracking-widest">{c.industry}</span>
               <h3 class="text-white font-display font-black text-4xl tracking-tighter">{c.client}</h3>
             </div>
             <div class="w-12 h-12 border border-white/10 flex items-center justify-center opacity-40 group-hover:opacity-100 transition-opacity">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
             </div>
          </div>

          <!-- Narrative -->
          <p class="text-muted text-xl font-body leading-relaxed group-hover:text-white transition-colors">
            {t(`proof.${c.id}.title`)}
          </p>

          <!-- Metrics Block -->
          <div class="mt-auto flex items-center gap-10">
             <div class="flex flex-col gap-1">
               <span class="text-white font-display font-black text-4xl group-hover:text-brand transition-colors">
                 {t(`proof.${c.id}.metric`)}
               </span>
               <span class="text-muted text-[8px] font-mono uppercase tracking-widest">{lang === 'en' ? 'MEASURED RESULT' : 'RESULTADO MEDIDO'}</span>
             </div>
             
             <!-- Tech Graph Mockup (CSS only) -->
             <div class="flex-1 flex flex-col gap-1 opacity-20 group-hover:opacity-100 transition-all">
                <div class="h-1 bg-white/10 w-full relative">
                   <div class="absolute left-0 top-0 h-full bg-brand w-[85%] animate-line-grow"></div>
                </div>
                <div class="flex justify-between font-mono text-[6px] text-white/40 uppercase">
                  <span>Start</span>
                  <span>Target</span>
                </div>
             </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
