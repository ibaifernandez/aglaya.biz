---
interface Props {
  dsn: string;
  environment: string;
  release?: string;
}

const {
  dsn,
  environment,
  release = '',
} = Astro.props;
---

<meta name="aglaya:sentry-dsn" content={dsn} />
<meta name="aglaya:sentry-environment" content={environment} />
{release && <meta name="aglaya:sentry-release" content={release} />}

<script>
  import * as Sentry from '@sentry/browser';

  const dsn =
    document.querySelector('meta[name="aglaya:sentry-dsn"]')?.getAttribute('content')?.trim() || '';
  const environment =
    document.querySelector('meta[name="aglaya:sentry-environment"]')?.getAttribute('content')?.trim() ||
    'production';
  const release =
    document.querySelector('meta[name="aglaya:sentry-release"]')?.getAttribute('content')?.trim() ||
    undefined;

  function initSentry() {
    if (!dsn || (window as any).__sentryInitialized) return;
    (window as any).__sentryInitialized = true;
    Sentry.init({
      dsn,
      environment,
      release,
      sendDefaultPii: false,
      tracesSampleRate: import.meta.env.DEV ? 1.0 : 0.15,
      integrations: [
        Sentry.browserTracingIntegration({
          tracePropagationTargets: [
            /^\/$/,
            /^https:\/\/aglaya\.biz/,
            /^https:\/\/www\.aglaya\.biz/,
          ],
        }),
      ],
      beforeSend(event) {
        if (event.request) {
          delete event.request.cookies;
          if (event.request.headers) {
            delete event.request.headers.authorization;
          }
        }
        return event;
      },
    });
  }

  if (dsn) {
    if (localStorage.getItem('aglaya_cookie_consent') === 'all') {
      initSentry();
    } else {
      window.addEventListener('aglaya:consent-update', function(e: any) {
        if (e.detail && e.detail.consent === 'all') initSentry();
      }, { once: true });
    }
  }
</script>
