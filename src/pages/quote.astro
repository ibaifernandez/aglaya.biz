---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteCalculator from '../components/QuoteCalculator.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const contactPath = translatePath('/contact');
---

<BaseLayout
  title={t('quote.meta.title')}
  description={t('quote.meta.description')}
  lang="en"
  alternateUrl={new URL('/es/quote/', Astro.site).href}
  alternateUrlPt={new URL('/pt/quote/', Astro.site).href}
>
  <Header />

  <main id="main-content" class="flex flex-col">

    <!-- Page Hero -->
    <section class="max-w-7xl mx-auto px-6 w-full pt-40 pb-20 flex flex-col gap-6">
      <span class="text-corporate-green font-mono text-[10px] font-black tracking-[0.4em] uppercase">{t('quote.hero.eyebrow')}</span>
      <h1 class="text-white font-display font-black text-5xl md:text-7xl lg:text-[8rem] tracking-tighter leading-[0.88] uppercase">
        {t('quote.hero.heading')}
      </h1>
      <p class="text-white/50 text-xl font-body leading-relaxed max-w-2xl mt-4">
        {t('quote.hero.subtext')}
      </p>
      <div class="w-24 h-1 bg-brand mt-4"></div>
    </section>

    <!-- Why AGLAYA Web -->
    <section class="max-w-6xl mx-auto px-6 w-full pb-8 grid grid-cols-1 md:grid-cols-3 gap-px bg-white/5 border border-white/5">
      <div class="bg-[#080808] p-8 flex flex-col gap-3">
        <span class="text-white font-display font-black text-lg uppercase tracking-tighter">You own it</span>
        <p class="text-white/50 font-body text-sm leading-relaxed">Delivered in your repo. No WordPress to babysit, no platform rent. If we vanish, your site keeps running.</p>
      </div>
      <div class="bg-[#080808] p-8 flex flex-col gap-3">
        <span class="text-white font-display font-black text-lg uppercase tracking-tighter">Built to last</span>
        <p class="text-white/50 font-body text-sm leading-relaxed">Lighthouse 100, blocking CI/CD, automated tests on every deploy. Engineering discipline, not a template.</p>
      </div>
      <div class="bg-[#080808] p-8 flex flex-col gap-3">
        <span class="text-white font-display font-black text-lg uppercase tracking-tighter">Proven live</span>
        <p class="text-white/50 font-body text-sm leading-relaxed">Running in production for <a href="https://djamapola.com" target="_blank" rel="noopener noreferrer" class="text-brand hover:text-white transition-colors">DJ Amapola</a> and Elm St.</p>
      </div>
    </section>

    <!-- Calculator -->
    <QuoteCalculator lang="en" contactPath={contactPath} />

  </main>

  <Footer />
</BaseLayout>
