---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProofGrid from '../../components/ProofGrid.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const metaDescription = t('proof.heading');

return Astro.redirect(lang === 'es' ? '/es/#proof' : '/#proof');
---

<BaseLayout
  title={`${t('proof.heading')} — AGLAYA`}
  description={metaDescription}
  lang={lang}
  alternateUrl={new URL('/es/proof/', Astro.site).href}
  noindex={true}
>
  <Header />
  <main id="main-content" class="flex flex-col">

    <!-- Page Hero -->
    <section class="relative min-h-[60vh] flex flex-col justify-center overflow-hidden bg-black border-b border-white/5">
      <div class="max-w-7xl mx-auto px-6 w-full flex flex-col gap-8 py-40">
        <div class="flex items-center gap-4" data-animate="fade-up">
          <div class="h-px bg-linear-to-r from-brand to-transparent w-full mt-2"></div>
          <span class="text-corporate-green font-mono text-[10px] sm:text-xs font-black tracking-[0.5em] uppercase">
            {t('hero.eyebrow')}
          </span>
        </div>
        <h1
          class="text-white font-display font-black text-5xl sm:text-7xl lg:text-8xl tracking-tighter leading-[0.9] uppercase"
          data-animate="fade-up"
        >
          {t('proof.heading')}
        </h1>
      </div>
    </section>

    <!-- Proof Grid -->
    <ProofGrid />

  </main>
  <Footer />
</BaseLayout>
