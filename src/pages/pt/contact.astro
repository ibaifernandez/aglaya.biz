---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ICPFilter from '../../components/ICPFilter.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isRoiAuditFlow =
  Astro.url.searchParams.get('type') === 'roi-audit' ||
  Astro.url.searchParams.get('entry_point') === 'roi_audit' ||
  Astro.url.searchParams.get('service_interest') === 'roi_audit';

const inquiryTypeOverride = isRoiAuditFlow ? 'ROI_AUDIT_LEAD' : '';
const entryPoint = isRoiAuditFlow ? 'roi_audit' : (Astro.url.searchParams.get('entry_point') ?? '');
const serviceInterest = isRoiAuditFlow ? 'roi_audit' : (Astro.url.searchParams.get('service_interest') ?? '');
---

<BaseLayout
  title={`${t('nav.contact')} — AGLAYA`}
  description={t('meta.description')}
  lang={lang}
>
  <Header />

  <main id="main-content" class="flex flex-col pt-32 min-h-screen">
    <section class="max-w-7xl mx-auto px-6 w-full flex flex-col items-center gap-12 py-20">
      <div class="flex flex-col items-center text-center gap-6 max-w-3xl">
        <span
          id="contact-context-eyebrow"
          data-roi-label={t('contact.roi_audit.eyebrow')}
          class="text-corporate-green font-mono text-[10px] font-black tracking-[0.4em] uppercase"
        >
          {isRoiAuditFlow ? t('contact.roi_audit.eyebrow') : t('nav.contact')}
        </span>
        <h1
          id="contact-context-heading"
          data-roi-label={t('contact.roi_audit.heading')}
          class="text-white font-display font-black text-5xl md:text-7xl tracking-tighter leading-none"
        >
          {isRoiAuditFlow ? t('contact.roi_audit.heading') : t('contact.heading')}
        </h1>
        <p
          id="contact-context-description"
          data-roi-label={t('contact.roi_audit.description')}
          class="text-muted text-lg font-body leading-relaxed max-w-2xl"
        >
          {isRoiAuditFlow ? t('contact.roi_audit.description') : t('contact.description')}
        </p>
      </div>
      <ICPFilter
        inquiryTypeOverride={inquiryTypeOverride}
        entryPoint={entryPoint}
        serviceInterest={serviceInterest}
      />
    </section>

    <script>
      const contactSearchParams = new URLSearchParams(window.location.search);
      const isRoiAuditContext =
        contactSearchParams.get('type') === 'roi-audit' ||
        contactSearchParams.get('entry_point') === 'roi_audit' ||
        contactSearchParams.get('service_interest') === 'roi_audit';

      if (isRoiAuditContext) {
        const eyebrow = document.getElementById('contact-context-eyebrow');
        const heading = document.getElementById('contact-context-heading');
        const description = document.getElementById('contact-context-description');

        if (eyebrow?.dataset.roiLabel) eyebrow.textContent = eyebrow.dataset.roiLabel;
        if (heading?.dataset.roiLabel) heading.textContent = heading.dataset.roiLabel;
        if (description?.dataset.roiLabel) description.textContent = description.dataset.roiLabel;
      }
    </script>

    <section class="bg-surface/30 py-20 border-t border-white/5">
      <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-12">
        <p class="text-white font-display font-bold text-xl tracking-tight opacity-50 italic">
          "{t('contact.quote')}"
        </p>
        <div class="flex items-center gap-6">
          <div class="flex flex-col items-end gap-1 font-mono text-[8px] text-muted uppercase tracking-[0.2em]">
            <span>Aglaya Global Ops</span>
            <span>Prazo de resposta: &lt; 24H</span>
          </div>
          <div class="w-12 h-12 bg-brand/10 border border-brand/20 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#e8003d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
