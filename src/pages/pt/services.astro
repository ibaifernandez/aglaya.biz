---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const criteria = [
  ['Você tem um projeto real', 'Não uma ideia que quer que validemos de graça. Algo com forma, com orçamento e com uma razão de existir.'],
  ['Você respeita o ofício', 'Quer bem feito, não rápido e descartável. Entende que o barato sai caro depois.'],
  ['Você é o dono do resultado', 'Nós executamos; você decide. Vamos te dizer a verdade desconfortável, e você vai agir sobre ela.'],
];
---

<BaseLayout
  title="Serviços — AGLAYA"
  description="A AGLAYA não vende serviços. De vez em quando aceitamos um trabalho de marketing — mas só quando o projeto merece. Isto é um filtro, não um menu."
  lang="pt"
  alternateUrl={new URL('/services/', Astro.site).href}
  alternateUrlEs={new URL('/es/services/', Astro.site).href}
>
  <Header />

  <main id="main-content" class="flex flex-col">

    <!-- Hero -->
    <section class="max-w-7xl mx-auto px-6 w-full pt-40 pb-20 flex flex-col gap-6">
      <span class="text-corporate-green font-mono text-[10px] font-black tracking-[0.4em] uppercase">Trabalhos Seletivos</span>
      <h1 class="text-white font-display font-black text-6xl md:text-8xl lg:text-[9rem] tracking-tighter leading-[0.88] uppercase">
        Não vendemos<br/>serviços.
      </h1>
      <p class="text-white/50 text-xl font-body leading-relaxed max-w-2xl mt-4">
        A não ser que a gente goste do seu projeto. Somos um estúdio de instalações soberanas, não uma agência de aluguel.
        Mas de vez em quando um trabalho de marketing vale o nosso tempo. Raramente. Nos nossos termos.
      </p>
      <div class="w-24 h-1 bg-brand mt-4"></div>
    </section>

    <!-- O filtro -->
    <section class="border-t border-white/5 bg-[#050505]">
      <div class="max-w-7xl mx-auto px-6 py-32 flex flex-col gap-16">
        <div class="flex flex-col gap-4">
          <span class="text-corporate-green font-mono text-[10px] font-black tracking-[0.4em] uppercase">O Filtro</span>
          <h2 class="text-white font-display font-black text-5xl md:text-7xl tracking-tighter leading-none uppercase">Você não nos contrata.<br/>Nós deixamos você entrar.</h2>
          <div class="w-12 h-1 bg-brand mt-2"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-white/5 border border-white/5">
          {criteria.map(([key, val]) => (
            <div class="bg-[#080808] p-10 flex flex-col gap-4">
              <span class="text-white font-display font-black text-xl uppercase tracking-tighter">{key}</span>
              <span class="text-white/50 font-body text-sm leading-relaxed">{val}</span>
            </div>
          ))}
        </div>

        <p class="text-white/40 font-body text-lg leading-relaxed max-w-2xl">
          Se soa arrogante, não é a oferta para você — e esse é exatamente o ponto.
          O filtro protege o trabalho. Quando um projeto encaixa, o que entregamos é a mesma
          disciplina que colocamos em tudo que construímos: <a href={translatePath('/the-stack/')} class="text-brand hover:text-white transition-colors">nossos sistemas</a>.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-white/5 py-32">
      <div class="max-w-4xl mx-auto px-6 flex flex-col items-center gap-10 text-center">
        <span class="text-corporate-green font-mono text-[10px] uppercase tracking-[0.5em]">SE_ENCAIXA</span>
        <h2 class="text-white font-display font-black text-5xl md:text-6xl tracking-tighter uppercase">Acha que seu projeto merece?</h2>
        <p class="text-white/50 font-body text-xl leading-relaxed max-w-xl">
          Conte o que você está construindo. Se encaixar, conversamos. Se não, também vamos te dizer.
        </p>
        <a
          href={translatePath('/contact/')}
          class="bg-brand hover:bg-brand-dark text-white px-16 py-6 font-display font-black text-xl uppercase tracking-widest transition-all transform hover:scale-[1.02]"
        >
          {t('nav.contact')} →
        </a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
