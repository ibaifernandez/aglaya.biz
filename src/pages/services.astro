---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const criteria = [
  ['You have a real project', 'Not an idea you want us to validate for free. Something with shape, budget, and a reason to exist.'],
  ['You respect the craft', 'You want it built right, not fast and disposable. You understand that cheap is expensive later.'],
  ['You own the outcome', 'We execute; you decide. We will tell you the uncomfortable truth, and you will act on it.'],
];
---

<BaseLayout
  title="Services — AGLAYA"
  description="AGLAYA doesn't sell services. Occasionally, we take on a marketing engagement — but only when the project earns it. This is a filter, not a menu."
  lang="en"
  alternateUrl={new URL('/es/services/', Astro.site).href}
  alternateUrlPt={new URL('/pt/services/', Astro.site).href}
>
  <Header />

  <main id="main-content" class="flex flex-col">

    <!-- Hero -->
    <section class="max-w-7xl mx-auto px-6 w-full pt-40 pb-20 flex flex-col gap-6">
      <span class="text-corporate-green font-mono text-[10px] font-black tracking-[0.4em] uppercase">Selective Engagements</span>
      <h1 class="text-white font-display font-black text-6xl md:text-8xl lg:text-[9rem] tracking-tighter leading-[0.88] uppercase">
        We don't<br/>sell services.
      </h1>
      <p class="text-white/50 text-xl font-body leading-relaxed max-w-2xl mt-4">
        Unless we like your project. We're a sovereign-installation studio, not an agency for hire.
        But now and then a marketing engagement is worth our time. Rarely. On our terms.
      </p>
      <div class="w-24 h-1 bg-brand mt-4"></div>
    </section>

    <!-- The filter -->
    <section class="border-t border-white/5 bg-bg-deep">
      <div class="max-w-7xl mx-auto px-6 py-32 flex flex-col gap-16">
        <div class="flex flex-col gap-4">
          <span class="text-corporate-green font-mono text-[10px] font-black tracking-[0.4em] uppercase">The Filter</span>
          <h2 class="text-white font-display font-black text-5xl md:text-7xl tracking-tighter leading-none uppercase">You don't hire us.<br/>We let you in.</h2>
          <div class="w-12 h-1 bg-brand mt-2"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-white/5 border border-white/5">
          {criteria.map(([key, val]) => (
            <div class="bg-surface p-10 flex flex-col gap-4">
              <span class="text-white font-display font-black text-xl uppercase tracking-tighter">{key}</span>
              <span class="text-white/50 font-body text-sm leading-relaxed">{val}</span>
            </div>
          ))}
        </div>

        <p class="text-white/40 font-body text-lg leading-relaxed max-w-2xl">
          If that sounds arrogant, it's not the offer for you — and that's the point.
          The filter protects the work. When a project fits, what we deliver is the same
          discipline we put into everything we build: <a href={translatePath('/the-stack/')} class="text-brand hover:text-white transition-colors">our systems</a>.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-white/5 py-32">
      <div class="max-w-4xl mx-auto px-6 flex flex-col items-center gap-10 text-center">
        <span class="text-corporate-green font-mono text-[10px] uppercase tracking-[0.5em]">IF_IT_FITS</span>
        <h2 class="text-white font-display font-black text-5xl md:text-6xl tracking-tighter uppercase">Think your project earns it?</h2>
        <p class="text-white/50 font-body text-xl leading-relaxed max-w-xl">
          Tell us what you're building. If it fits, we'll talk. If it doesn't, we'll tell you that too.
        </p>
        <a
          href={translatePath('/contact/')}
          class="bg-brand hover:bg-brand-dark text-white px-16 py-6 font-display font-black text-xl uppercase tracking-widest transition-all transform hover:scale-[1.02]"
        >
          {t('nav.contact')} →
        </a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
