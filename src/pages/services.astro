---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const systems = [
  {
    id: '01',
    name: 'Systemic Alchemy',
    tagline: 'Manual processes → autonomous digital assets',
    cases: 'Lead qualification, reporting automation, internal approval flows, client onboarding, post-sale follow-up, invoicing, inventory management',
    stack: 'n8n / Make / Zapier / Python / Custom APIs / Webhooks',
  },
  {
    id: '02',
    name: 'Narrative Delivery',
    tagline: 'Marketing execution with system integrity',
    cases: 'CRM with lead scoring, conditional email sequences, semi-automated content system, conversion funnel with attribution, marketing intelligence dashboard',
    stack: 'Resend / HubSpot / Notion / Airtable / Astro / Next.js',
  },
  {
    id: '03',
    name: 'Zero-Leak Architecture',
    tagline: 'High-performance digital infrastructure',
    cases: 'High-conversion web, authentication systems, owned data infrastructure, third-party integrations without vendor lock-in, internal API architecture',
    stack: 'Astro / Next.js / Netlify / Vercel / PostgreSQL / Supabase / Cloudflare',
  },
  {
    id: '04',
    name: 'AI Orchestration',
    tagline: 'Applied intelligence on core business',
    cases: 'Customer support agents with real business context, automatic data analysis with actionable insights, brand-calibrated content generation, intelligent lead routing',
    stack: 'Claude API / OpenAI / LangChain / RAG / Vector databases',
  },
  {
    id: '05',
    name: 'Productive Friction',
    tagline: 'Strategic challenge to expose truth',
    cases: 'Positioning and messaging audit, sales funnel review, brand-operation narrative coherence, strategic prioritization before building',
    stack: '1–3 intensive sessions (4h each) + actionable written deliverable',
  },
];

const conditions = [
  ['Minimum contract', '3 months retainer'],
  ['Retainer price', '$8,000/month USD. No discounts. The price is the signal.'],
  ['Maximum capacity', '2 simultaneous retainer clients'],
  ['Payment method', 'Bank transfer, Wise or equivalent. First of the month.'],
  ['Working language', 'Spanish or English per client'],
  ['Entry criterion', 'Prior ROI Audit or clear evidence of strategic fit'],
  ['Exit policy', '30 days notice. The client keeps everything built.'],
];
---

<BaseLayout
  title="Services — AGLAYA"
  description="AGLAYA doesn't sell services. We sell infrastructure. Five system architectures that automate your operations permanently. You own everything we build."
  lang="en"
  alternateUrl={new URL('/es/services/', Astro.site).href}
  alternateUrl={new URL('/es/services/', Astro.site).href}
>
  <Header />

  <main id="main-content" class="flex flex-col">

    <!-- Page Hero -->
    <section class="max-w-7xl mx-auto px-6 w-full pt-40 pb-20 flex flex-col gap-6">
      <span class="text-corporate-green font-mono text-[10px] font-black tracking-[0.4em] uppercase">Service Architecture</span>
      <h1 class="text-white font-display font-black text-6xl md:text-8xl lg:text-[9rem] tracking-tighter leading-[0.88] uppercase">
        We don't<br/>sell services.
      </h1>
      <p class="text-white/50 text-xl font-body leading-relaxed max-w-2xl mt-4">
        A service ends when the month ends. Infrastructure keeps running when you're not watching.
        We build the latter.
      </p>
      <div class="w-24 h-1 bg-brand mt-4"></div>
    </section>

    <!-- Philosophy Strip -->
    <section class="border-t border-b border-white/5 bg-[#050505]">
      <div class="max-w-7xl mx-auto px-6 py-0 grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-white/5">
        <div class="flex flex-col gap-4 p-10 md:p-14">
          <span class="text-corporate-green font-mono text-[8px] uppercase tracking-[0.5em]">01 / NARRATIVE</span>
          <h3 class="text-white font-display font-black text-2xl uppercase tracking-tighter">Identify operational truth</h3>
          <p class="text-white/40 font-body text-sm leading-relaxed">We find and articulate exactly what's breaking, leaking, or costing you margin.</p>
        </div>
        <div class="flex flex-col gap-4 p-10 md:p-14">
          <span class="text-corporate-green font-mono text-[8px] uppercase tracking-[0.5em]">02 / SYSTEM</span>
          <h3 class="text-white font-display font-black text-2xl uppercase tracking-tighter">Build the architecture</h3>
          <p class="text-white/40 font-body text-sm leading-relaxed">We design and deploy the technical infrastructure that makes the narrative operable and measurable.</p>
        </div>
        <div class="flex flex-col gap-4 p-10 md:p-14">
          <span class="text-corporate-green font-mono text-[8px] uppercase tracking-[0.5em]">03 / SOVEREIGNTY</span>
          <h3 class="text-white font-display font-black text-2xl uppercase tracking-tighter">You own everything</h3>
          <p class="text-white/40 font-body text-sm leading-relaxed">The client owns the system. AGLAYA maintains and evolves it. No vendor lock-in. Ever.</p>
        </div>
      </div>
    </section>

    <!-- 5 Systems -->
    <section class="max-w-7xl mx-auto px-6 w-full py-32 flex flex-col gap-16">
      <div class="flex flex-col gap-4">
        <span class="text-corporate-green font-mono text-[10px] font-black tracking-[0.4em] uppercase">System Catalog</span>
        <h2 class="text-white font-display font-black text-5xl md:text-7xl tracking-tighter leading-none uppercase">Five systems.<br/>One infrastructure.</h2>
        <div class="w-12 h-1 bg-brand mt-2"></div>
      </div>

      <div class="flex flex-col divide-y divide-white/5 border border-white/5">
        {systems.map((s) => (
          <div class="bg-[#080808] hover:bg-[#0a0a0a] transition-colors p-10 md:p-14 grid grid-cols-1 md:grid-cols-3 gap-10">
            <div class="flex flex-col gap-4">
              <span class="text-corporate-green font-mono text-[8px] uppercase tracking-[0.5em]">SYSTEM_{s.id}</span>
              <h3 class="text-white font-display font-black text-2xl md:text-3xl uppercase tracking-tighter">{s.name}</h3>
              <p class="text-white/40 font-body text-sm italic">{s.tagline}</p>
            </div>
            <div class="flex flex-col gap-3">
              <span class="text-white/20 font-mono text-[8px] uppercase tracking-widest">Use Cases</span>
              <p class="text-white/60 font-body text-sm leading-relaxed">{s.cases}</p>
            </div>
            <div class="flex flex-col gap-3">
              <span class="text-white/20 font-mono text-[8px] uppercase tracking-widest">Stack / Format</span>
              <p class="text-white/40 font-mono text-xs leading-relaxed">{s.stack}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Pricing -->
    <section class="bg-[#050505] border-t border-white/5">
      <div class="max-w-7xl mx-auto px-6 py-32 flex flex-col gap-16">
        <div class="flex flex-col gap-4">
          <span class="text-corporate-green font-mono text-[10px] font-black tracking-[0.4em] uppercase">Investment</span>
          <h2 class="text-white font-display font-black text-5xl md:text-7xl tracking-tighter uppercase">Two entry points.<br/>One direction.</h2>
          <div class="w-12 h-1 bg-brand mt-2"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-white/5">

          <!-- ROI Audit -->
          <div class="bg-[#080808] p-12 flex flex-col gap-8">
            <div class="flex flex-col gap-2">
              <span class="text-corporate-green font-mono text-[8px] uppercase tracking-[0.5em]">Entry Point</span>
              <h3 class="text-white font-display font-black text-3xl uppercase tracking-tighter">ROI Audit</h3>
            </div>
            <div class="flex items-baseline gap-3">
              <span class="text-white font-display font-black text-6xl tracking-tighter">$1,500</span>
              <span class="text-white/30 font-mono text-xs uppercase">USD</span>
            </div>
            <p class="text-white/50 font-body text-sm leading-relaxed">
              2-week working session with your team. We map every manual process and quantify its exact monthly cost.
              Output: system design + business case with explicit assumptions.
            </p>
            <p class="text-corporate-green font-mono text-[9px] uppercase tracking-widest border-t border-white/10 pt-6">
              Deductible from first retainer month if contracted within 30 days.
            </p>
            <a
              href={translatePath('/roi-audit')}
              class="mt-auto bg-white text-black px-8 py-4 font-display font-black text-sm uppercase tracking-widest hover:bg-brand hover:text-white transition-all w-fit"
            >
              Full details →
            </a>
          </div>

          <!-- System Retainer -->
          <div class="bg-brand p-12 flex flex-col gap-8">
            <div class="flex flex-col gap-2">
              <span class="text-white/70 font-mono text-[8px] uppercase tracking-[0.5em]">Core Product</span>
              <h3 class="text-white font-display font-black text-3xl uppercase tracking-tighter">System Retainer</h3>
            </div>
            <div class="flex items-baseline gap-3">
              <span class="text-white font-display font-black text-6xl tracking-tighter">$8,000</span>
              <span class="text-white/70 font-mono text-xs uppercase">/month</span>
            </div>
            <ul class="flex flex-col gap-3 text-white/90 font-body text-sm">
              <li class="flex gap-3 items-start"><span class="text-white/50 mt-0.5">—</span>Direct access to architect, not an account manager</li>
              <li class="flex gap-3 items-start"><span class="text-white/50 mt-0.5">—</span>Design + build of priority automations</li>
              <li class="flex gap-3 items-start"><span class="text-white/50 mt-0.5">—</span>Continuous maintenance and system evolution</li>
              <li class="flex gap-3 items-start"><span class="text-white/50 mt-0.5">—</span>Weekly 30–45 min sync + async real-time updates</li>
              <li class="flex gap-3 items-start"><span class="text-white/50 mt-0.5">—</span>Impact metrics dashboard (time saved, conversions, cost reduced)</li>
            </ul>
            <p class="text-white/50 font-mono text-[9px] uppercase tracking-widest border-t border-white/20 pt-6">
              Max 2 active retainers simultaneously. 3-month minimum commitment.
            </p>
            <a
              href={translatePath('/contact')}
              class="mt-auto bg-black text-white px-8 py-4 font-display font-black text-sm uppercase tracking-widest hover:bg-[#111] transition-all w-fit"
            >
              {t('nav.contact')} →
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- Work Conditions -->
    <section class="max-w-7xl mx-auto px-6 w-full py-24 flex flex-col gap-12">
      <span class="text-corporate-green font-mono text-[10px] font-black tracking-[0.4em] uppercase">Work Conditions</span>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-white/5 border border-white/5">
        {conditions.map(([key, val]) => (
          <div class="bg-[#080808] p-8 flex flex-col gap-2">
            <span class="text-white/30 font-mono text-[9px] uppercase tracking-widest">{key}</span>
            <span class="text-white font-body text-sm">{val}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-white/5 bg-[#050505] py-32">
      <div class="max-w-4xl mx-auto px-6 flex flex-col items-center gap-10 text-center">
        <span class="text-corporate-green font-mono text-[10px] uppercase tracking-[0.5em]">NEXT_STEP</span>
        <h2 class="text-white font-display font-black text-5xl md:text-6xl tracking-tighter uppercase">Start with the audit.</h2>
        <p class="text-white/50 font-body text-xl leading-relaxed max-w-xl">
          If we can't find $15K/month in automatable work, we say so. No pitch. That honesty is the product.
        </p>
        <a
          href={translatePath('/roi-audit')}
          class="bg-brand hover:bg-brand-dark text-white px-16 py-6 font-display font-black text-xl uppercase tracking-widest transition-all transform hover:scale-[1.02]"
        >
          Book ROI Audit →
        </a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
