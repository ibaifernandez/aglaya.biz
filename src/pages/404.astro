---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

Astro.response.status = 404;

const copy = lang === 'es'
  ? {
      lang: 'es',
      title: 'AGLAYA — Página no encontrada',
      description: 'La página que buscas no existe. Construimos sistemas que siguen funcionando cuando no estamos.',
      sub: 'Página no encontrada.',
      body: 'La URL que introdujiste no existe o ha sido movida.',
      cta: 'Volver al inicio',
      ctaHref: '/es/',
    }
  : lang === 'pt'
  ? {
      lang: 'pt',
      title: 'AGLAYA — Página não encontrada',
      description: 'A página que você está procurando não existe. Construímos sistemas que continuam funcionando quando não estamos.',
      sub: 'Página não encontrada.',
      body: 'O URL que você digitou não existe ou foi movido.',
      cta: 'Voltar ao início',
      ctaHref: '/pt/',
    }
  : {
      lang: 'en',
      title: 'AGLAYA — Page not found',
      description: 'The page you are looking for does not exist. We build systems that keep running when we\'re not in the room.',
      sub: 'Page not found.',
      body: 'The URL you entered does not exist or has been moved.',
      cta: 'Back to home',
      ctaHref: '/',
    };
---

<BaseLayout title={copy.title} description={copy.description} lang={copy.lang} noindex={true}>
  <main class="min-h-screen flex flex-col items-center justify-center px-6 py-20 text-center">
    <div class="max-w-3xl">
      <!-- 404 Error Code -->
      <div class="text-brand font-mono text-9xl font-black tracking-tighter mb-6">404</div>

      <!-- Error Message -->
      <h1 class="text-white font-display font-black text-5xl md:text-7xl tracking-tighter leading-tight mb-8">
        {copy.sub}
      </h1>

      <p class="text-muted font-body text-xl md:text-2xl leading-relaxed mb-12">
        {copy.body}
      </p>

      <!-- CTA -->
      <a
        href={copy.ctaHref}
        class="inline-block bg-brand hover:bg-brand-dark text-white px-10 py-5 font-display text-lg font-black uppercase tracking-widest transition-all hover:scale-[1.02] active:scale-95"
      >
        {copy.cta}
      </a>

      <!-- Brand Accent Line -->
      <div class="mt-16 pt-8 border-t border-white/10">
        <div class="w-px h-24 bg-gradient-to-b from-brand to-transparent mx-auto"></div>
      </div>
    </div>
  </main>
</BaseLayout>
