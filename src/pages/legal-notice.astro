---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Legal Notice — AGLAYA"
  description="Legal identification and responsible entity information for aglaya.biz"
  lang="en"
  alternateUrlEs={new URL('/es/aviso-legal/', Astro.site).href}
  alternateUrlPt={new URL('/pt/aviso-legal/', Astro.site).href}
>
  <Header />
  <main id="main-content" class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-20 py-40 flex flex-col gap-12">
    <h1 class="font-display font-black text-4xl sm:text-6xl uppercase tracking-tighter text-white">Legal Notice</h1>

    <div class="max-w-2xl flex flex-col gap-6 text-white/70 font-body leading-relaxed">
      <p>Last updated: May 3, 2026</p>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">Responsible Entity</h2>
      <p>
        In compliance with Article 10 of Law 34/2002 on Information Society Services and Electronic Commerce (LSSI-CE), the following identifying information is provided:
      </p>
      <ul class="flex flex-col gap-2 list-none">
        <li><span class="text-white font-bold">Individual:</span> Antonio Ibai Fernández Gutiérrez</li>
        <li><span class="text-white font-bold">Trading name:</span> AGLAYA</li>
        <li><span class="text-white font-bold">Tax ID (DNI):</span> 74853234X</li>
        <li><span class="text-white font-bold">Address:</span> Rua Palestina s/n, Belo Horizonte, Minas Gerais, Brasil. CEP 30850-000</li>
        <li><span class="text-white font-bold">Contact email:</span> <a href="mailto:info@aglaya.biz" class="text-brand hover:text-brand-light underline underline-offset-2">info@aglaya.biz</a></li>
        <li><span class="text-white font-bold">Website:</span> aglaya.biz</li>
      </ul>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">Purpose of the Website</h2>
      <p>aglaya.biz is the commercial website of AGLAYA, a digital marketing agency specialising in AI-powered systems and operations. The site provides information about services offered and channels for prospective clients to initiate contact.</p>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">Intellectual Property</h2>
      <p>All content on this website — including but not limited to text, graphics, logos, icons, images, and code — is the property of AGLAYA or its content suppliers and is protected by applicable intellectual property laws. Unauthorised reproduction, distribution, or modification of any content is prohibited without prior written consent.</p>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">Limitation of Liability</h2>
      <p>AGLAYA makes reasonable efforts to keep the information on this site accurate and up to date, but does not guarantee its completeness or suitability for any particular purpose. AGLAYA is not liable for any damages arising from the use of, or inability to use, the content of this website.</p>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">External Links</h2>
      <p>This website may contain links to third-party websites. AGLAYA is not responsible for the content, privacy practices, or accuracy of information on those sites.</p>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">Applicable Law</h2>
      <p>This Legal Notice is governed by Spanish law. Any disputes arising in connection with this website shall be subject to the jurisdiction of the courts of Spain, unless otherwise required by applicable consumer protection legislation.</p>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">Related Policies</h2>
      <p>
        See our <a href="/privacy/" class="text-brand hover:text-brand-light underline underline-offset-2">Privacy Policy</a> and <a href="/cookies/" class="text-brand hover:text-brand-light underline underline-offset-2">Cookie Policy</a> for details on how we handle personal data and cookies.
      </p>
    </div>
  </main>
  <Footer />
</BaseLayout>
