---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Cookie Policy — AGLAYA"
  description="How AGLAYA uses cookies on aglaya.biz"
  lang="en"
  alternateUrl={new URL('/es/cookies/', Astro.site).href}
>
  <Header />
  <main id="main-content" class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-20 py-40 flex flex-col gap-12">
    <h1 class="font-display font-black text-4xl sm:text-6xl uppercase tracking-tighter text-white">Cookie Policy</h1>

    <div class="max-w-2xl flex flex-col gap-6 text-white/70 font-body leading-relaxed">
      <p>Last updated: May 15, 2026</p>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">What We Use</h2>
      <p>aglaya.biz uses a combination of browser localStorage and third-party cookies to maintain site integrity, protect against abuse, and — with your explicit consent — analyze aggregate traffic patterns. No advertising or cross-site tracking cookies are used.</p>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">Essential (Always Active)</h2>
      <p>These cannot be disabled. They are strictly necessary for the site to function and do not store personally identifiable information.</p>

      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-white/10">
              <th class="text-left text-white/50 font-mono text-[10px] uppercase tracking-widest py-3 pr-4">Name / Key</th>
              <th class="text-left text-white/50 font-mono text-[10px] uppercase tracking-widest py-3 pr-4">Provider</th>
              <th class="text-left text-white/50 font-mono text-[10px] uppercase tracking-widest py-3 pr-4">Purpose</th>
              <th class="text-left text-white/50 font-mono text-[10px] uppercase tracking-widest py-3">Duration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <tr>
              <td class="py-3 pr-4 font-mono text-xs text-white/80">aglaya_cookie_consent</td>
              <td class="py-3 pr-4">AGLAYA</td>
              <td class="py-3 pr-4">Stores your cookie consent choice (localStorage key — not a cookie). Prevents the banner from showing again after you decide.</td>
              <td class="py-3">Until manually cleared</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-mono text-xs text-white/80">hCaptcha session</td>
              <td class="py-3 pr-4">hCaptcha (Intuition Machines, Inc. — US)</td>
              <td class="py-3 pr-4">Anti-abuse verification token. Required to submit contact, ROI Audit, quote, and dispatch forms. No personal data stored beyond the verification session.</td>
              <td class="py-3">Session</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-mono text-xs text-white/80">Sentry session</td>
              <td class="py-3 pr-4">Sentry (Functional Software, Inc. — US)</td>
              <td class="py-3 pr-4">Anonymous error tracking. Captures browser errors and performance data to help us detect and fix site failures. No personal data intentionally collected.</td>
              <td class="py-3">Session / up to 90 days in Sentry</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">Analytics (Consent Required)</h2>
      <p>These are only loaded after you click "Accept All". If you choose "Essential Only" or "Decline", none of these are loaded.</p>

      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-white/10">
              <th class="text-left text-white/50 font-mono text-[10px] uppercase tracking-widest py-3 pr-4">Name / Key</th>
              <th class="text-left text-white/50 font-mono text-[10px] uppercase tracking-widest py-3 pr-4">Provider</th>
              <th class="text-left text-white/50 font-mono text-[10px] uppercase tracking-widest py-3 pr-4">Purpose</th>
              <th class="text-left text-white/50 font-mono text-[10px] uppercase tracking-widest py-3">Duration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <tr>
              <td class="py-3 pr-4 font-mono text-xs text-white/80">_ga, _ga_*</td>
              <td class="py-3 pr-4">Google Analytics 4 (Google LLC — US)</td>
              <td class="py-3 pr-4">Aggregate traffic analysis: page views, session duration, traffic sources. Data is anonymized — no individual tracking.</td>
              <td class="py-3">_ga: 2 years; _ga_*: 2 years</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-mono text-xs text-white/80">GTM container</td>
              <td class="py-3 pr-4">Google Tag Manager (Google LLC — US)</td>
              <td class="py-3 pr-4">Loads analytics scripts after consent is confirmed. No cookies set by GTM itself.</td>
              <td class="py-3">Session</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">Your Choices</h2>
      <p>You can change your cookie preferences at any time using the button below. Clicking it clears your saved choice and re-opens the consent banner.</p>

      <button
        id="reset-cookies-btn"
        type="button"
        class="inline-flex items-center gap-2 border border-white/20 bg-white/[0.03] px-5 py-3 font-display text-[11px] font-black uppercase tracking-[0.18em] text-white/70 transition-all hover:border-white/40 hover:text-white cursor-pointer"
      >
        Reset Cookie Preferences
      </button>

      <p class="text-white/46 text-xs">You can also manually clear the localStorage key <code class="font-mono bg-white/5 px-1 py-0.5 rounded">aglaya_cookie_consent</code> in your browser developer tools.</p>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">Contact</h2>
      <p>Questions about cookies or data? <a href="mailto:info@aglaya.biz" class="text-brand hover:text-brand-light underline underline-offset-2">info@aglaya.biz</a></p>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
document.getElementById('reset-cookies-btn')?.addEventListener('click', () => {
  localStorage.removeItem('aglaya_cookie_consent');
  const banner = document.getElementById('cookie-banner');
  if (banner) {
    banner.hidden = false;
    requestAnimationFrame(() => requestAnimationFrame(() => banner.classList.add('is-visible')));
  }
});
</script>
