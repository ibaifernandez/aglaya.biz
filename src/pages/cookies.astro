---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Cookie Policy — AGLAYA"
  description="How AGLAYA uses cookies on aglaya.biz"
  lang="en"
  alternateUrl={new URL('/es/cookies/', Astro.site).href}
>
  <Header />
  <main id="main-content" class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-20 py-40 flex flex-col gap-12">
    <h1 class="font-display font-black text-4xl sm:text-6xl uppercase tracking-tighter text-white">Cookie Policy</h1>

    <div class="prose prose-invert max-w-2xl flex flex-col gap-6 text-white/70 font-body leading-relaxed">
      <p>Last updated: April 2026</p>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">Essential Cookies</h2>
      <p>Required for the site to function. Cannot be disabled. These include session management and security tokens. No personal data is stored.</p>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">Analytics Cookies</h2>
      <p>Used to understand how visitors interact with the site (page views, session duration, traffic sources). Collected in aggregate — no individual tracking. Only activated if you accept all cookies.</p>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">Your Choices</h2>
      <p>You can change your preferences at any time by clearing your browser's <code>localStorage</code> key <code>aglaya_cookie_consent</code> and reloading the page.</p>

      <h2 class="text-white font-display font-black text-xl uppercase tracking-widest">Contact</h2>
      <p>Questions? <a href="mailto:info@aglaya.biz" class="text-brand hover:text-brand-light underline underline-offset-2">info@aglaya.biz</a></p>
    </div>
  </main>
  <Footer />
</BaseLayout>
