---
/**
 * HIDDEN PREVIEW of the new home page. Not linked from anywhere, `noindex`, out
 * of the sitemap (filter in astro.config.mjs), English only and so with no
 * hreflang (`isUnpaired` in src/i18n/routes.ts). The current home page is
 * untouched.
 *
 * Reference: docs/design/portada-nueva/portada-aglaya.html. Built tramo by
 * tramo; T1, T2 and T3 are filled. Everything it uses lives in
 * src/components/preview-home/ — dropping the preview means deleting that
 * folder and this file.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PreviewHeader from '../../components/preview-home/PreviewHeader.astro';
import Hook from '../../components/preview-home/Hook.astro';
import Problem from '../../components/preview-home/Problem.astro';
import Built from '../../components/preview-home/Built.astro';
import PreviewFooter from '../../components/preview-home/PreviewFooter.astro';
import '../../components/preview-home/preview-home.css';
// The face of T1's paragraph — the page's largest paint. Same file the package's
// @font-face points at (one hashed asset), asked for first so the faces further
// down the page do not hold it up.
import lcpFont from '@aglaya/design-tokens/fonts/Inter-Regular.otf?url';
---

<BaseLayout
  title="AGLAYA — preview"
  description="Preview of the new AGLAYA home page."
  lang="en"
  theme="light"
  noindex
>
  <div class="pv">
    <link rel="preload" href={lcpFont} as="font" type="font/otf" crossorigin />
    <PreviewHeader />
    <main id="main-content">
      <!-- T1 · the hook -->
      <Hook />
      <!-- T2 · the problem -->
      <Problem />
      <!-- T3 · what we've built -->
      <Built />
      <!-- T4 · the Orchestrator -->
      <section class="pv-section" id="orchestrator" data-tramo="T4"></section>
      <!-- T5 · how we work -->
      <section class="pv-section" id="work" data-tramo="T5"></section>
      <!-- T6 · let's talk -->
      <section class="pv-section" id="contact" data-tramo="T6"></section>
    </main>
    <PreviewFooter />
  </div>
</BaseLayout>

<script>
  import '../../components/preview-home/effects';
  import '../../components/preview-home/story-selector';
</script>
