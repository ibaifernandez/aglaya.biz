---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ProofDossier from '../../../components/ProofDossier.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const entries = await getCollection('proof');
  return entries.map(entry => ({
    params: { slug: entry.id.replace('.md', '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { 
  title, client, industry, challenge, strategy, vision, 
  summary, results, solution_systems, date, 
  heroImage, thumbImage, contentImage 
} = entry.data as any;
const slug = Astro.params.slug;

const bodyContent = marked.parse((entry.data as any)[`body_${lang}`] || (entry.data as any).body_es || '');
---

<BaseLayout
  title={`${title[lang]} — AGLAYA ${t('nav.proof')}`}
  description={challenge[lang]}
  ogType="article"
  lang={lang}
  alternateUrl={new URL(`/proof/${slug}/`, Astro.site).href}
>
  <Header />
  
  <main id="main-content" class="w-full">
    <ProofDossier
      title={title}
      client={client}
      industry={industry}
      challenge={challenge}
      strategy={strategy}
      vision={vision}
      summary={summary}
      results={results}
      solution_systems={solution_systems}
      date={date}
      lang={lang}
      id={entry.id}
      heroImage={heroImage}
      thumbImage={thumbImage}
      contentImage={contentImage}
      bodyHtml={bodyContent as string}
    />
  </main>

  <Footer wide />
</BaseLayout>
