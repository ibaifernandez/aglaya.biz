---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const criteria = [
  ['Tienes un proyecto real', 'No una idea que quieres que validemos gratis. Algo con forma, con presupuesto y con una razón de existir.'],
  ['Respetas el oficio', 'Lo quieres bien hecho, no rápido y desechable. Entiendes que lo barato sale caro después.'],
  ['Tú eres el dueño del resultado', 'Nosotros ejecutamos; tú decides. Te diremos la verdad incómoda, y tú actuarás sobre ella.'],
];
---

<BaseLayout
  title="Servicios — AGLAYA"
  description="AGLAYA no vende servicios. De vez en cuando aceptamos un encargo de marketing — pero solo cuando el proyecto se lo gana. Esto es un filtro, no un menú."
  lang="es"
  alternateUrl={new URL('/services/', Astro.site).href}
  alternateUrlPt={new URL('/pt/services/', Astro.site).href}
>
  <Header />

  <main id="main-content" class="flex flex-col">

    <!-- Hero -->
    <section class="max-w-7xl mx-auto px-6 w-full pt-40 pb-20 flex flex-col gap-6">
      <span class="text-corporate-green font-mono text-[10px] font-black tracking-[0.4em] uppercase">Encargos Selectivos</span>
      <h1 class="text-white font-display font-black text-6xl md:text-8xl lg:text-[9rem] tracking-tighter leading-[0.88] uppercase">
        No vendemos<br/>servicios.
      </h1>
      <p class="text-white/50 text-xl font-body leading-relaxed max-w-2xl mt-4">
        Salvo que nos guste tu proyecto. Somos un estudio de instalaciones soberanas, no una agencia de alquiler.
        Pero de tanto en tanto un encargo de marketing merece nuestro tiempo. Pocas veces. En nuestros términos.
      </p>
      <div class="w-24 h-1 bg-brand mt-4"></div>
    </section>

    <!-- El filtro -->
    <section class="border-t border-white/5 bg-[#050505]">
      <div class="max-w-7xl mx-auto px-6 py-32 flex flex-col gap-16">
        <div class="flex flex-col gap-4">
          <span class="text-corporate-green font-mono text-[10px] font-black tracking-[0.4em] uppercase">El Filtro</span>
          <h2 class="text-white font-display font-black text-5xl md:text-7xl tracking-tighter leading-none uppercase">No nos contratas.<br/>Te dejamos entrar.</h2>
          <div class="w-12 h-1 bg-brand mt-2"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-white/5 border border-white/5">
          {criteria.map(([key, val]) => (
            <div class="bg-[#080808] p-10 flex flex-col gap-4">
              <span class="text-white font-display font-black text-xl uppercase tracking-tighter">{key}</span>
              <span class="text-white/50 font-body text-sm leading-relaxed">{val}</span>
            </div>
          ))}
        </div>

        <p class="text-white/40 font-body text-lg leading-relaxed max-w-2xl">
          Si suena arrogante, no es la oferta para ti — y ese es justo el punto.
          El filtro protege el trabajo. Cuando un proyecto encaja, lo que entregamos es la misma
          disciplina que ponemos en todo lo que construimos: <a href={translatePath('/the-stack/')} class="text-brand hover:text-white transition-colors">nuestros sistemas</a>.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-white/5 py-32">
      <div class="max-w-4xl mx-auto px-6 flex flex-col items-center gap-10 text-center">
        <span class="text-corporate-green font-mono text-[10px] uppercase tracking-[0.5em]">SI_ENCAJA</span>
        <h2 class="text-white font-display font-black text-5xl md:text-6xl tracking-tighter uppercase">¿Crees que tu proyecto se lo gana?</h2>
        <p class="text-white/50 font-body text-xl leading-relaxed max-w-xl">
          Cuéntanos qué estás construyendo. Si encaja, hablamos. Si no, también te lo diremos.
        </p>
        <a
          href={translatePath('/contact/')}
          class="bg-brand hover:bg-brand-dark text-white px-16 py-6 font-display font-black text-xl uppercase tracking-widest transition-all transform hover:scale-[1.02]"
        >
          {t('nav.contact')} →
        </a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
