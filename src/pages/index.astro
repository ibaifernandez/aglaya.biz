---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import ProofGrid from '../components/ProofGrid.astro';
import SystemsGrid from '../components/SystemsGrid.astro';
import Economics from '../components/Economics.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout 
  title={t('meta.title')} 
  description={t('meta.description')}
  lang={lang}
>
  <Header />
  
  <main id="main-content" class="flex flex-col">
    <!-- 1. Hero -->
    <Hero />

    <!-- 2. Problem (the enemies) -->
    <Problem />

    <!-- 3. The Stack (teaser) -->
    <SystemsGrid />

    <!-- 4. Live examples -->
    <ProofGrid />

    <!-- 5. Economics -->
    <Economics />

    <!-- 6. Call to Action → ROI Audit -->
    <section id="contact" class="px-6 py-24 sm:px-10 lg:px-20 bg-black border-t border-white/5">
      <div class="max-w-4xl mx-auto flex flex-col items-center gap-10 text-center" data-animate="fade-up">
        <SectionHeader
          eyebrow={t('contact.eyebrow')}
          heading1={t('final.heading')}
        />
        <p class="text-white/60 font-body text-xl max-w-2xl italic">
          {t('final.subtext')}
        </p>
        <a
          href={translatePath('/roi-audit/')}
          class="bg-brand hover:bg-brand-dark text-white px-16 py-6 font-display font-black text-xl uppercase tracking-widest transition-all transform hover:scale-[1.02]"
        >
          {t('nav.roi_audit')} →
        </a>
      </div>
    </section>
  </main>

  <!-- 9. Footer -->
  <Footer />
</BaseLayout>
