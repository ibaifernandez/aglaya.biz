{
  "name": "aglaya.biz-astro",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "tokens:bridge": "node scripts/generate-tailwind-theme.mjs",
    "tokens:version": "aglaya-tokens-version",
    "tokens:mutation-proof": "bash scripts/mutation-proof.sh",
    "lockfile:https": "node scripts/lockfile-https.mjs",
    "prepare": "npm run tokens:bridge",
    "predev": "npm run tokens:bridge",
    "dev": "astro dev",
    "prebuild": "npm run tokens:bridge",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run test:unit && npm run test:e2e",
    "pretest:unit": "npm run tokens:bridge",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "astro check",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore dist --ignore .astro --ignore graphify-out --ignore docs/delivery"
  },
  "dependencies": {
    "@aglaya/design-tokens": "git+https://github.com/ibaifernandez/aglaya-design-system.git#v1.1.0",
    "@astrojs/netlify": "^8.2.4",
    "@astrojs/sitemap": "^3.7.3",
    "@sentry/astro": "^10.48.0",
    "@sentry/node": "^10.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pdfkit": "^0.17.6",
    "astro": "^7.2.9",
    "marked": "^18.0.0",
    "mermaid": "^11.14.0",
    "pdfkit": "^0.18.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.11.1",
    "@netlify/functions": "^5.1.3",
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.1.0",
    "markdownlint-cli": "^0.48.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
